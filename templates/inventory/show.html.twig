{% extends 'base.html.twig' %}

{% block title %}Inventory Details{% endblock %}

{% block stylesheets %}
  <style>
    .dashboard-container {
      display: flex;
      min-height: 100vh;
    }

    .main-content {
      flex: 1;
      padding: 1.5rem;
    }

    h1 {
      margin-bottom: 1rem;
      font-size: 1.5rem;
      color: #92400e;
      text-align: center;
    }

    .details-card {
      background: white;
      border-radius: 12px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      padding: 1.5rem;
      max-width: 800px;
      margin: 0 auto;
      overflow: hidden;
    }

    .details-table {
      width: 100%;
      border-collapse: collapse;
    }

    .details-table th,
    .details-table td {
      padding: 0.75rem;
      text-align: left;
      border-bottom: 1px solid #e5e7eb;
      vertical-align: top;
    }

    .details-table th {
      background-color: #f3f4f6;
      font-weight: 600;
      width: 200px;
    }

    /* ===== Buttons ===== */
    .btn {
      padding: 0.5rem 1rem;
      font-size: 0.9rem;
      border: none;
      border-radius: 4px;
      cursor: pointer;
      text-decoration: none;
      color: white;
      display: inline-block;
      text-align: center;
      transition: background-color 0.3s ease;
    }

    .back-btn {
      background-color: #92400e;
    }
    .back-btn:hover {
      background-color: #78350f;
    }

    .edit-btn {
      background-color: #d97706;
    }
    .edit-btn:hover {
      background-color: #b45309;
    }

    .delete-btn {
      background-color: #b91c1c;
    }
    .delete-btn:hover {
      background-color: #991b1b;
    }

    .actions-container {
      margin-top: 1.5rem;
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      justify-content: center;
    }

    @media (max-width: 768px) {
      .details-card {
        padding: 1rem;
      }
      .details-table th, .details-table td {
        font-size: 0.85rem;
        display: block;
        width: 100%;
      }
      .details-table th {
        background-color: transparent;
        padding-top: 1rem;
        font-weight: 700;
      }
      .details-table td {
        padding-bottom: 1rem;
      }
    }
  </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
  {% include 'dashboard/sidebar.html.twig' %}

  <div class="main-content">
    <h1>📦 Inventory Details</h1>

    <div class="details-card">
      <table class="details-table">
        <tbody>
          <tr>
            <th>ID</th>
            <td>{{ inventory.id }}</td>
          </tr>
          <tr>
            <th>Quantity</th>
            <td>{{ inventory.quantity }}</td>
          </tr>
          <tr>
            <th>Created At</th>
            <td>{{ inventory.createdAt ? inventory.createdAt|date('Y-m-d H:i:s') : '' }}</td>
          </tr>
          {% if inventory.product is defined and inventory.product %}
          <tr>
            <th>Related Product</th>
            <td>{{ inventory.product.productName }} (ID: {{ inventory.product.id }})</td>
          </tr>
          {% endif %}
        </tbody>
      </table>

      <div class="actions-container">
        <a href="{{ path('app_inventory_index') }}" class="btn back-btn">← Back to list</a>
        <a href="{{ path('app_inventory_edit', {'id': inventory.id}) }}" class="btn edit-btn">✏️ Edit</a>

        <form method="post" action="{{ path('app_inventory_delete', {'id': inventory.id}) }}" onsubmit="return confirm('Are you sure you want to delete this inventory entry?');">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ inventory.id) }}">
         {{ include('inventory/_delete_form.html.twig', {'inventory': inventory}) }}

        </form>
      </div>
    </div>
  </div>
</div>
{% endblock %}
