{% extends 'base.html.twig' %}

{% block title %}PetSale{% endblock %}

{% block body %}
    <h1>PetSale</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ pet_sale.id }}</td>
            </tr>
            <tr>
                <th>Image</th>
                <td>{{ pet_sale.image }}</td>
            </tr>
            <tr>
                <th>Dogbreed</th>
                <td>{{ pet_sale.dogbreed }}</td>
            </tr>
            <tr>
                <th>Dogage</th>
                <td>{{ pet_sale.dogage }}</td>
            </tr>
            <tr>
                <th>Datepurchased</th>
                <td>{{ pet_sale.datepurchased ? pet_sale.datepurchased|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Datetosale</th>
                <td>{{ pet_sale.datetosale ? pet_sale.datetosale|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Discription</th>
                <td>{{ pet_sale.discription }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_pet_sale_index') }}">back to list</a>

    <a href="{{ path('app_pet_sale_edit', {'id': pet_sale.id}) }}">edit</a>

    {{ include('pet_sale/_delete_form.html.twig') }}
{% endblock %}
