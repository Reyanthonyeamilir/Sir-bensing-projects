{% extends 'base.html.twig' %}

{% block title %}Edit Pet Product{% endblock %}

{% block body %}
<style>
  .dashboard-container {
    display: flex;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    padding: 1rem;
    overflow-x: auto;
  }

  .table-container {
    overflow-x: auto;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1rem;
    margin-top: 1rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  h1 {
    font-size: 1.5rem;
    color: #92400e;
    margin-bottom: 1rem;
    text-align: center;
  }

  /* ====== FORM STYLING ====== */
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  label {
    font-weight: 600;
    display: block;
    margin-bottom: 0.25rem;
    color: #4b5563;
  }

  input[type="text"],
  input[type="number"],
  input[type="file"],
  textarea,
  select {
    width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid #d1d5db;
    border-radius: 6px;
    font-size: 0.9rem;
    transition: border-color 0.2s ease;
    background-color: white;
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: #d97706;
    box-shadow: 0 0 0 2px rgba(217, 119, 6, 0.2);
  }

  textarea {
    min-height: 100px;
    resize: vertical;
  }

  .current-image {
    text-align: center;
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .current-image img {
    max-width: 200px;
    max-height: 200px;
    border-radius: 8px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.15);
    object-fit: cover;
  }

  /* ====== BUTTONS ====== */
  .btn {
    padding: 0.45rem 0.8rem;
    font-size: 0.85rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    color: white;
    display: inline-block;
    text-align: center;
    transition: background-color 0.3s ease;
  }

  .action-btn {
    background-color: #d97706; /* orange */
  }
  .action-btn:hover {
    background-color: #b45309;
  }

  .edit-btn {
    background-color: #92400e; /* brown */
  }
  .edit-btn:hover {
    background-color: #78350f;
  }

  .delete-btn {
    background-color: #b91c1c; /* red */
  }
  .delete-btn:hover {
    background-color: #991b1b;
  }

  .form-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  @media (max-width: 768px) {
    .btn {
      width: 100%;
    }
  }
</style>

<div class="dashboard-container">
  {% include 'Dashboard/sidebar.html.twig' %}

  <main class="main-content">
    <h1>Edit Pet Product</h1>

    <div class="table-container">

      {# ✅ Show current image if it exists #}
      {% if petproduct.imageUrl %}
        <div class="current-image">
          <img src="{{ asset('uploads/' ~ petproduct.imageUrl) }}" alt="{{ petproduct.productName }}">
          <p style="font-size: 0.85rem; color: #6b7280; margin-top: 0.25rem;">Current image</p>
        </div>
      {% endif %}

      {# ✅ Render the entire form automatically, no hardcoded field names #}
      {{ form_start(form) }}
        {{ form_widget(form) }}

        <div class="form-actions">
          <button class="btn action-btn">{{ button_label|default('Update') }}</button>
          <a href="{{ path('app_petproducts_index') }}" class="btn edit-btn">← Back to List</a>
          {{ include('petproducts/_delete_form.html.twig', { 'button_label': 'Delete', 'attr': { 'class': 'btn delete-btn' } }) }}
        </div>
      {{ form_end(form) }}
    </div>
  </main>
</div>
{% endblock %}
