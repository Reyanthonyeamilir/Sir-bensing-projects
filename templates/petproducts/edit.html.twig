{% extends 'base.html.twig' %}

{% block title %}Edit Pet Product{% endblock %}

{% block body %}
<style>
  html, body {
    min-height: 100%;
    margin: 0;
    background: #f8f9fa;
    overflow-x: hidden;
  }

  .dashboard-container {
    display: flex;
    min-height: 100vh;
  }

  /* ✅ Main area next to sidebar - centered */
  .main-content {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    padding: 2rem;
    margin-left: 250px; /* Space for sidebar */
    box-sizing: border-box;
  }

  .table-container {
    width: 100%;
    max-width: 650px; /* Match create page width */
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1.5rem 2rem;
    margin-top: 0;
  }

  h1 {
    color: #cc5404; /* Match create page color */
    font-weight: 700;
    font-size: 1.8rem;
    text-align: center;
    padding: 1rem;
    border-bottom: 1px solid #eee;
    margin: 0 0 1rem 0;
  }

  /* ====== FORM STYLING ====== */
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  label {
    font-weight: 600;
    display: block;
    margin-bottom: 0.25rem;
    color: #4b5563;
  }

  input[type="text"],
  input[type="number"],
  input[type="file"],
  textarea,
  select {
    width: 100%;
    padding: 0.7rem 1rem;
    border: 1px solid #ccc;
    border-radius: 8px;
    font-size: 1rem;
    background: #fff;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  input:focus,
  textarea:focus,
  select:focus {
    outline: none;
    border-color: #cc5404; /* Match create page focus color */
    box-shadow: 0 0 5px rgba(204, 84, 4, 0.3);
  }

  textarea {
    min-height: 100px;
    resize: vertical;
  }

  .current-image {
    text-align: center;
    margin: 0.5rem 0;
    padding: 1rem;
    background: #f9fafb;
    border: 1px dashed #ddd;
    border-radius: 8px;
  }

  .current-image img {
    max-width: 100%;
    max-height: 200px;
    border-radius: 8px;
    object-fit: cover;
  }

  /* ====== BUTTONS ====== */
  .btn {
    padding: 0.8rem 1.5rem;
    font-size: 1rem;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    text-decoration: none;
    color: white;
    display: inline-block;
    text-align: center;
    font-weight: 600;
    transition: background 0.3s ease, transform 0.2s ease;
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .action-btn {
    background-color: #cc5404; /* Match create page button color */
  }
  .action-btn:hover {
    background-color: #a63d03;
  }

  .edit-btn {
    background-color: #6c757d; /* Gray for back button */
  }
  .edit-btn:hover {
    background-color: #5a6268;
  }

  .form-actions {
    display: flex;
    justify-content: space-between; /* Match create page button layout */
    align-items: center;
    margin-top: 1.5rem;
  }

  /* Mobile responsiveness */
  @media (max-width: 768px) {
    .dashboard-container {
      flex-direction: column;
    }

    .main-content {
      padding: 1rem;
      margin-left: 0;
      justify-content: center;
    }

    .table-container {
      max-width: 100%;
    }

    .form-actions {
      flex-direction: column;
      gap: 1rem;
    }
    
    .btn {
      width: 100%;
    }
  }
</style>

<div class="dashboard-container">
  {% include 'Dashboard/sidebar.html.twig' %}

  <main class="main-content">
    <div class="table-container">
      <h1>Edit Pet Product</h1>

      {# ✅ Show current image if it exists #}
      {% if petproduct.imageUrl %}
        <div class="current-image">
          <img src="{{ asset('uploads/' ~ petproduct.imageUrl) }}" alt="{{ petproduct.productName }}">
          <p style="font-size: 0.85rem; color: #6b7280; margin-top: 0.5rem;">Current image</p>
        </div>
      {% endif %}

      {# ✅ Render the entire form automatically, no hardcoded field names #}
      {{ form_start(form) }}
        {{ form_widget(form) }}

        <div class="form-actions">
          <a href="{{ path('app_petproducts_index') }}" class="btn edit-btn">← Back to List</a>
          <button class="btn action-btn">{{ button_label|default('Update') }}</button>
        </div>
      {{ form_end(form) }}
    </div>
  </main>
</div>
{% endblock %}