{% extends 'base.html.twig' %}

{% block title %}Pet Products{% endblock %}

{% block body %}
<style>
  /* COMPLETELY OFFLINE - NO NETWORK DEPENDENCIES */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  body, html { 
    background: transparent !important; 
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  }
  
  .dashboard-container { 
    display: flex; 
    min-height: 100vh; 
    background: transparent; 
  }
  
  .main-content { 
    flex: 1; 
    padding: 1.5rem; 
    background: transparent; 
    margin-left: 280px; 
    max-width: calc(100% - 280px);
  }
  
  h1 { 
    font-size: 1.6rem; 
    font-weight: 700; 
    color: #f8ea6ac5; 
    margin-bottom: 1.2rem; 
    text-align: center; 
    padding-bottom: 0.8rem;
    border-bottom: 2px solid #ff7b35;
  }
  
  .table-container {
    overflow-x: auto;
    background: rgba(255, 255, 255, 0.95);
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    padding: 0.8rem;
  }
  
  .pet-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 800px;
  }
  
  .pet-table th, .pet-table td {
    padding: 0.6rem;
    text-align: left;
    border-bottom: 1px solid #e0e0e0;
    vertical-align: middle;
    font-size: 0.9rem;
    color: #333;
  }
  
  .pet-table th {
    background: #f8f8f8;
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 0.5px;
    color: #555;
  }
  
  .pet-table tr:hover { 
    background: rgba(255, 123, 53, 0.05); 
    transition: background 0.2s ease; 
  }
  
  .product-img {
    width: 55px;
    height: 55px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid #ddd;
  }
  
  .no-image { 
    font-style: italic; 
    color: #888; 
    font-size: 0.85rem;
  }
  
  .btn {
    padding: 0.4rem 0.7rem;
    font-size: 0.8rem;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    display: inline-block;
    text-align: center;
    transition: all 0.2s ease;
    font-weight: 500;
  }
  
  .btn:hover { 
    transform: translateY(-1px); 
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }
  
  .action-btn { 
    background-color: #cc5404; 
  }
  
  .action-btn:hover { 
    background-color: #b34903; 
  }
  
  .edit-btn { 
    background-color: #5a3922; 
  }
  
  .edit-btn:hover { 
    background-color: #4a2e1b; 
  }
  
  .actions-cell { 
    display: flex; 
    gap: 5px; 
    justify-content: center; 
  }
  
  .new-btn-container { 
    text-align: center; 
    margin-top: 1.2rem; 
  }
  
  .create-btn {
    background-color: #cc5404;
    padding: 0.6rem 1.2rem;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 6px;
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    transition: all 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  
  .create-btn:hover { 
    background-color: #b34903; 
    transform: translateY(-2px); 
    box-shadow: 0 4px 8px rgba(0,0,0,0.15);
  }
  
  .create-btn::before {
    content: "+";
    font-size: 1.1rem;
    font-weight: bold;
  }
  
  .description-container { 
    max-width: 200px; 
  }
  
  .description-text {
    max-height: 45px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    font-size: 0.8rem;
    color: #555;
    line-height: 1.4;
  }
  
  .description-text.expanded { 
    max-height: none; 
    -webkit-line-clamp: unset; 
  }
  
  .toggle-btn {
    background: none;
    border: none;
    color: #cc5404;
    cursor: pointer;
    font-size: 0.75rem;
    padding: 0;
    margin-top: 3px;
    text-decoration: underline;
    font-weight: 500;
  }
  
  .toggle-btn:hover {
    color: #a63e00;
  }
  
  /* Custom check/cross icons - NO FONT AWESOME */
  .active-yes::before {
    content: "✓";
    color: #28a745;
    font-weight: bold;
  }
  
  .active-no::before {
    content: "✗";
    color: #dc3545;
    font-weight: bold;
  }
  
  /* Responsive */
  @media (max-width: 768px) {
    .main-content {
      margin-left: 0;
      max-width: 100%;
      padding: 1rem;
    }
    
    .pet-table th, .pet-table td { 
      font-size: 0.75rem; 
      padding: 0.5rem;
    }
    
    .product-img { 
      width: 40px; 
      height: 40px; 
    }
    
    .btn {
      padding: 0.3rem 0.5rem;
      font-size: 0.75rem;
    }
  }
</style>

<div class="dashboard-container">
  {% include 'dashboard/sidebar.html.twig' %}

  <main class="main-content">
    <h1>Pet Products</h1>

    <div class="table-container">
      <table class="pet-table" id="petTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Image</th>
            <th>Name</th>
            <th>Category</th>
            <th>Sub Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Brand</th>
            <th>Active</th>
            <th>Created</th>
            <th>Description</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for petproduct in petproducts %}
          <tr>
            <td>{{ petproduct.id }}</td>
            <td>
              {% if petproduct.imageUrl %}
                <img src="{{ asset('uploads/' ~ petproduct.imageUrl) }}" alt="Product Image" class="product-img">
              {% else %}
                <span class="no-image">No image</span>
              {% endif %}
            </td>
            <td>{{ petproduct.productName }}</td>
            <td>{{ petproduct.category }}</td>
            <td>{{ petproduct.subCategory }}</td>
            <td>${{ petproduct.price|number_format(2) }}</td>
            <td>{{ petproduct.stock }}</td>
            <td>{{ petproduct.brand }}</td>
            <td class="{{ petproduct.isActive ? 'active-yes' : 'active-no' }}">
              {{ petproduct.isActive ? ' Yes' : ' No' }}
            </td>
            <td>{{ petproduct.createdAt ? petproduct.createdAt|date('Y-m-d H:i') : '' }}</td>
            <td>
              <div class="description-container">
                <p class="description-text">{{ petproduct.description }}</p>
                {% if petproduct.description and petproduct.description|length > 50 %}
                  <button type="button" class="toggle-btn">Read more</button>
                {% endif %}
              </div>
            </td>
            <td>
              <div class="actions-cell">
                <a href="{{ path('app_petproducts_show', {'id': petproduct.id}) }}" class="btn action-btn">View</a>
                <a href="{{ path('app_petproducts_edit', {'id': petproduct.id}) }}" class="btn edit-btn">Edit</a>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="12" style="text-align: center; padding: 1.5rem;">
              No products found. <a href="{{ path('app_petproducts_new') }}" style="color: #cc5404; text-decoration: underline;">Create your first product</a>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="new-btn-container">
      <a href="{{ path('app_petproducts_new') }}" class="btn create-btn">Add New Product</a>
    </div>
  </main>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Read more/less toggle
    document.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.previousElementSibling;
        text.classList.toggle('expanded');
        btn.textContent = text.classList.contains('expanded') ? 'Read less' : 'Read more';
      });
    });
    
    // Add row hover effects
    const tableRows = document.querySelectorAll('.pet-table tbody tr');
    tableRows.forEach(row => {
      row.addEventListener('mouseenter', () => {
        row.style.backgroundColor = 'rgba(255, 123, 53, 0.08)';
      });
      
      row.addEventListener('mouseleave', () => {
        row.style.backgroundColor = '';
      });
    });
  });
</script>
{% endblock %}