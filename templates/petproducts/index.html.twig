{% extends 'base.html.twig' %}

{% block title %}Pet Products{% endblock %}

{% block body %}
<style>
  .dashboard-container {
    display: flex;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    padding: 1rem;
    overflow-x: auto;
  }

  .table-container {
    overflow-x: auto;
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1rem;
    margin-top: 1rem;
  }

  .pet-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 900px;
  }

  .pet-table th, .pet-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: top;
  }

  .pet-table th {
    background-color: #f3f4f6;
    font-weight: 600;
  }

  .product-img {
    width: 70px;
    height: 70px;
    object-fit: cover;
    border-radius: 6px;
  }

  .no-image {
    font-style: italic;
    color: #aaa;
  }

  /* ====== BUTTONS ====== */
  .btn {
    padding: 0.45rem 0.8rem;
    font-size: 0.85rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    color: white;
    display: inline-block;
    text-align: center;
    transition: background-color 0.3s ease;
  }

  /* Orange-brown theme */
  .action-btn {
    background-color: #d97706; /* orange */
  }
  .action-btn:hover {
    background-color: #b45309;
  }

  .edit-btn {
    background-color: #92400e; /* brown */
  }
  .edit-btn:hover {
    background-color: #78350f;
  }

  .actions-cell {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }

  /* Add New Product Button */
  .create-btn {
    display: inline-block;
    background-color: #d97706;
    padding: 0.65rem 1.2rem;
    font-weight: 600;
    font-size: 0.95rem;
    border-radius: 6px;
    margin-top: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  }

  .create-btn:hover {
    background-color: #b45309;
  }

  .description-container {
    max-width: 220px;
    position: relative;
  }

  .description-text {
    max-height: 50px;
    overflow: hidden;
    text-overflow: ellipsis;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    transition: max-height 0.3s ease;
    margin: 0;
    font-size: 0.9rem;
  }

  .description-text.expanded {
    max-height: 300px;
    -webkit-line-clamp: unset;
  }

  .toggle-btn {
    background: none;
    border: none;
    color: #d97706;
    cursor: pointer;
    font-size: 0.8rem;
    padding: 0;
    margin-top: 4px;
  }

  .toggle-btn:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .pet-table th, .pet-table td {
      font-size: 0.8rem;
      padding: 0.5rem;
    }
    .description-container {
      max-width: 150px;
    }
    .product-img {
      width: 50px;
      height: 50px;
    }
    .actions-cell {
      flex-direction: column;
    }
    .btn {
      width: 100%;
    }
    .create-btn {
      width: 100%;
      text-align: center;
    }
  }
</style>

<div class="dashboard-container">
  {% include 'dashboard/sidebar.html.twig' %}

  <main class="main-content">
    <h1>Pet Products</h1>

    <div class="table-container">
      <table class="pet-table">
        <thead>
          <tr>
            <th>ID</th>
             <th>Image</th>
            <th>Product ID</th>
            <th>Name</th>
            <th>Category</th>
            <th>Sub Category</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Brand</th>
            <th>Active</th>
            <th>Created</th>
            <th>Description</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
        {% for petproduct in petproducts %}
          <tr>
            <td>{{ petproduct.id }}</td>
             <td>
              {% if petproduct.imageUrl %}
                <img src="{{ asset('uploads/' ~ petproduct.imageUrl) }}" alt="Product Image" class="product-img">
              {% else %}
                <span class="no-image">No image</span>
              {% endif %}
            </td>
            <td>{{ petproduct.productId }}</td>
            <td>{{ petproduct.productName }}</td>
            <td>{{ petproduct.category }}</td>
            <td>{{ petproduct.subCategory }}</td>
            <td>
              <div class="description-container">
                <p class="description-text">{{ petproduct.description }}</p>
                <button type="button" class="toggle-btn">Read more</button>
              </div>
            </td>
            <td>{{ petproduct.price }}</td>
            <td>{{ petproduct.stock }}</td>
            <td>{{ petproduct.brand }}</td>
            <td>{{ petproduct.isActive ? '✅' : '❌' }}</td>
            <td>{{ petproduct.createdAt ? petproduct.createdAt|date('Y-m-d H:i') : '' }}</td>
            <td>
              <div class="actions-cell">
                <a href="{{ path('app_petproducts_show', {'id': petproduct.id}) }}" class="btn action-btn">View</a>
                <a href="{{ path('app_petproducts_edit', {'id': petproduct.id}) }}" class="btn edit-btn">Edit</a>
              </div>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="13">No records found</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>

    <div class="new-btn-container">
      <a href="{{ path('app_petproducts_new') }}" class="btn create-btn">+ Add New Product</a>
    </div>
  </main>
</div>

<script>
  // ✅ Toggle description behavior
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.toggle-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const text = btn.previousElementSibling;
        text.classList.toggle('expanded');
        btn.textContent = text.classList.contains('expanded') ? 'Read less' : 'Read more';
      });
    });
  });
</script>
{% endblock %}
