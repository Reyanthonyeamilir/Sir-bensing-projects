{{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'class': 'pet-form'}}) }}

  <div class="form-group">
    {{ form_label(form.name) }}
    {{ form_widget(form.name, {'attr': {'class': 'input'}}) }}
    {{ form_errors(form.name) }}
  </div>

  <div class="form-group">
    {{ form_label(form.email) }}
    {{ form_widget(form.email, {'attr': {'class': 'input'}}) }}
    {{ form_errors(form.email) }}
  </div>

  <div class="form-group">
    {{ form_label(form.password) }}
    {{ form_widget(form.password, {'attr': {'class': 'input'}}) }}
    {{ form_errors(form.password) }}
  </div>

  <div class="form-group">
    {{ form_label(form.address) }}
    {{ form_widget(form.address, {'attr': {'class': 'input'}}) }}
    {{ form_errors(form.address) }}
  </div>

  <div class="form-group">
    {{ form_label(form.phone) }}
    {{ form_widget(form.phone, {'attr': {'class': 'input'}}) }}
    {{ form_errors(form.phone) }}
  </div>

  <button class="btn btn-submit">{{ button_label|default('Save') }}</button>

{{ form_end(form) }}
