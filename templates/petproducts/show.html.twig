{% extends 'base.html.twig' %}

{% block title %}Pet Product Details{% endblock %}

{% block body %}
<style>
  .dashboard-container {
    display: flex;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    padding: 1.5rem;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    color: #92400e;
  }

  .details-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
    overflow: hidden;
  }

  .details-table {
    width: 100%;
    border-collapse: collapse;
  }

  .details-table th,
  .details-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: top;
  }

  .details-table th {
    background-color: #f3f4f6;
    font-weight: 600;
    width: 200px;
  }

  .product-image {
    max-width: 220px;
    max-height: 220px;
    border-radius: 10px;
    object-fit: cover;
    display: block;
    margin: 10px 0;
    box-shadow: 0 2px 6px rgba(0,0,0,0.1);
  }

  /* ===== Buttons ===== */
  .btn {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    color: white;
    display: inline-block;
    text-align: center;
    transition: background-color 0.3s ease;
  }

  .back-btn {
    background-color: #92400e; /* brown */
    margin-right: 8px;
  }
  .back-btn:hover {
    background-color: #78350f;
  }

  .edit-btn {
    background-color: #d97706; /* orange */
    margin-right: 8px;
  }
  .edit-btn:hover {
    background-color: #b45309;
  }

  .delete-btn {
    background-color: #b91c1c; /* red */
  }
  .delete-btn:hover {
    background-color: #991b1b;
  }

  .actions-container {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .details-card {
      padding: 1rem;
    }
    .details-table th, .details-table td {
      font-size: 0.85rem;
      display: block;
      width: 100%;
    }
    .details-table th {
      background-color: transparent;
      padding-top: 1rem;
      font-weight: 700;
    }
    .details-table td {
      padding-bottom: 1rem;
    }
  }
</style>

<div class="dashboard-container">
  {% include 'Dashboard/sidebar.html.twig' %}

  <main class="main-content">
    <h1>Pet Product Details</h1>

    <div class="details-card">
      <table class="details-table">
        <tbody>
          <tr>
            <th>ID</th>
            <td>{{ petproduct.id }}</td>
          </tr>
          <tr>
            <th>Product ID</th>
            <td>{{ petproduct.productId }}</td>
          </tr>
          <tr>
            <th>Product Name</th>
            <td>{{ petproduct.productName }}</td>
          </tr>
          <tr>
            <th>Category</th>
            <td>{{ petproduct.category }}</td>
          </tr>
          <tr>
            <th>Sub Category</th>
            <td>{{ petproduct.subCategory }}</td>
          </tr>
          <tr>
            <th>Description</th>
            <td>{{ petproduct.description }}</td>
          </tr>
          <tr>
            <th>Price</th>
            <td>{{ petproduct.price }}</td>
          </tr>
          <tr>
            <th>Stock</th>
            <td>{{ petproduct.stock }}</td>
          </tr>
          <tr>
            <th>Brand</th>
            <td>{{ petproduct.brand }}</td>
          </tr>
          <tr>
            <th>Image</th>
            <td>
              {% if petproduct.imageUrl %}
                <img src="{{ asset('uploads/' ~ petproduct.imageUrl) }}" alt="{{ petproduct.productName }}" class="product-image">
              {% else %}
                <em>No image</em>
              {% endif %}
            </td>
          </tr>
          <tr>
            <th>Active</th>
            <td>{{ petproduct.isActive ? 'Yes ✅' : 'No ❌' }}</td>
          </tr>
          <tr>
            <th>Created At</th>
            <td>{{ petproduct.createdAt ? petproduct.createdAt|date('Y-m-d H:i:s') : '' }}</td>
          </tr>
        </tbody>
      </table>

      <div class="actions-container">
        <a href="{{ path('app_petproducts_index') }}" class="btn back-btn">← Back to List</a>
        <a href="{{ path('app_petproducts_edit', {'id': petproduct.id}) }}" class="btn edit-btn">✏️ Edit</a>
        {{ include('petproducts/_delete_form.html.twig', { 'button_label': 'Delete', 'attr': { 'class': 'btn delete-btn' } }) }}
      </div>
    </div>
  </main>
</div>
{% endblock %}
