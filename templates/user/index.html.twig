{% extends 'base.html.twig' %}

{% block title %}User Management{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <!-- DataTables CSS (add if not in base.html.twig) -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css">
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css">
    <style>
        /* Button Design Styles - Orange-Brown/Brown theme with right alignment */
        .action-buttons {
            display: flex;
            gap: 0.5rem;
            flex-wrap: nowrap;
            justify-content: flex-end;
            width: 100%;
        }
        
        /* VIEW BUTTON - Orange Brown */
        .btn-view {
            padding: 0.5rem 1rem;
            background: linear-gradient(135deg, #D2691E 0%, #CD853F 100%);
            color: white;
            border: 1px solid #A0522D;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 1px 3px rgba(210, 105, 30, 0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 80px;
            letter-spacing: 0.3px;
            white-space: nowrap;
        }
        
        .btn-view:hover {
            background: linear-gradient(135deg, #CD853F 0%, #D2691E 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(205, 133, 63, 0.25);
            color: white;
            border-color: #8B4513;
        }
        
        /* EDIT BUTTON - Brown */
        .btn-edit {
            padding: 0.5rem 1rem;
            background: linear-gradient(135deg, #8B4513 0%, #A0522D 100%);
            color: white;
            border: 1px solid #5D4037;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 1px 3px rgba(139, 69, 19, 0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 80px;
            letter-spacing: 0.3px;
            white-space: nowrap;
        }
        
        .btn-edit:hover {
            background: linear-gradient(135deg, #A0522D 0%, #8B4513 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(160, 82, 45, 0.25);
            color: white;
            border-color: #3E2723;
        }
        
        /* ACTIVATE/DEACTIVATE BUTTONS */
        .btn-activate {
            padding: 0.5rem 1rem;
            background: linear-gradient(135deg, #16a34a 0%, #22c55e 100%);
            color: white;
            border: 1px solid #15803d;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 1px 3px rgba(34, 197, 94, 0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 100px;
            letter-spacing: 0.3px;
            white-space: nowrap;
            cursor: pointer;
        }
        
        .btn-activate:hover {
            background: linear-gradient(135deg, #15803d 0%, #16a34a 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(21, 128, 61, 0.25);
            color: white;
            border-color: #166534;
        }
        
        .btn-deactivate {
            padding: 0.5rem 1rem;
            background: linear-gradient(135deg, #dc2626 0%, #ef4444 100%);
            color: white;
            border: 1px solid #b91c1c;
            border-radius: 6px;
            font-size: 0.875rem;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 1px 3px rgba(239, 68, 68, 0.2);
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 100px;
            letter-spacing: 0.3px;
            white-space: nowrap;
            cursor: pointer;
        }
        
        .btn-deactivate:hover {
            background: linear-gradient(135deg, #b91c1c 0%, #dc2626 100%);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(185, 28, 28, 0.25);
            color: white;
            border-color: #991b1b;
        }
        
        /* Focus states for accessibility */
        .btn-view:focus,
        .btn-edit:focus,
        .btn-activate:focus,
        .btn-deactivate:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(139, 69, 19, 0.3);
        }
        
        /* Table action cell adjustments */
        .sem-actions-td {
            min-width: 200px;
        }
        
        .sem-actions-td .action-buttons {
            justify-content: flex-end;
            padding-right: 0;
        }
        
        /* Align actions column header to the right */
        .sem-actions-col {
            text-align: right !important;
        }
        
        .sem-table-th.sem-actions-col {
            text-align: right !important;
            padding-right: 1.5rem !important;
        }
        
        /* Status badges */
        .status-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .status-active {
            background: rgba(34, 197, 94, 0.1);
            color: #16a34a;
            border: 1px solid rgba(34, 197, 94, 0.2);
        }
        
        .status-inactive {
            background: rgba(239, 68, 68, 0.1);
            color: #dc2626;
            border: 1px solid rgba(239, 68, 68, 0.2);
        }
        
        /* Role badges */
        .role-badge {
            display: inline-block;
            padding: 0.25rem 0.75rem;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            margin: 0.125rem;
        }
        
        .role-admin {
            background: rgba(234, 179, 8, 0.1);
            color: #ca8a04;
            border: 1px solid rgba(234, 179, 8, 0.2);
        }
        
        .role-staff {
            background: rgba(59, 130, 246, 0.1);
            color: #2563eb;
            border: 1px solid rgba(59, 130, 246, 0.2);
        }
        
        .role-user {
            background: rgba(107, 114, 128, 0.1);
            color: #4b5563;
            border: 1px solid rgba(107, 114, 128, 0.2);
        }
        
        /* Date styling */
        .date-cell {
            font-size: 0.875rem;
            color: #6b7280;
            white-space: nowrap;
        }
        
        /* Responsive adjustments for buttons */
        @media (max-width: 768px) {
            .action-buttons {
                justify-content: center;
                flex-wrap: wrap;
                gap: 0.5rem;
            }
            
            .btn-view, .btn-edit, .btn-activate, .btn-deactivate {
                min-width: 80px;
                padding: 0.625rem 0.75rem;
                font-size: 0.875rem;
                flex: 1;
                max-width: 120px;
            }
            
            .sem-actions-td {
                min-width: auto;
            }
            
            .sem-actions-td .action-buttons {
                justify-content: center;
            }
            
            .sem-table-th.sem-actions-col {
                text-align: center !important;
                padding-right: 12px !important;
            }
        }
        
        /* For small mobile screens */
        @media (max-width: 480px) {
            .action-buttons {
                flex-direction: column;
                align-items: stretch;
            }
            
            .btn-view, .btn-edit, .btn-activate, .btn-deactivate {
                max-width: 100%;
                width: 100%;
                min-width: 100%;
            }
        }
        
        /* Align the "Add New User" button to the right */
        .sem-new-btn-container { 
            text-align: right; 
            margin-top: 1.5rem; 
            background: white;
            padding: 1rem 0;
        }
        
        @media (max-width: 768px) {
            .sem-new-btn-container {
                text-align: center;
            }
        }
    </style>
{% endblock %}

{% block body %}
<div class="user-crud">
    {% include 'dashboard/sidebar.html.twig' %}

    <main class="main-content">
        <div class="sem-container">
            <div class="sem-header">
                <h1>User Management</h1>
            </div>
            
            <div class="sem-content">
                <div class="sem-table-container sem-datatable-container">
                    <table class="sem-table sem-datatable" id="userTable">
                        <thead>
                            <tr class="sem-table-header">
                                <th class="sem-table-th">ID</th>
                                <th class="sem-table-th">Username</th>
                                <th class="sem-table-th">Roles</th>
                                <th class="sem-table-th">Status</th>
                                 <th class="sem-table-th">Created At</th>
                                <th class="sem-table-th sem-actions-col">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for user in users %}
                            <tr class="sem-table-row">
                                <td class="sem-table-td">#{{ user.id }}</td>
                                <td class="sem-table-td">{{ user.username }}</td>
                                <td class="sem-table-td">
                                    {% for role in user.roles %}
                                        {% if role == 'ROLE_ADMIN' %}
                                            <span class="role-badge role-admin">Admin</span>
                                        {% elseif role == 'ROLE_staff' %}
                                            <span class="role-badge role-staff">Staff</span>
                                        {% elseif role == 'ROLE_USER' %}
                                            <span class="role-badge role-user">User</span>
                                        {% endif %}
                                    {% endfor %}
                                </td>
    
                                <td class="sem-table-td">
                                    {% if user.isActive %}
                                        <span class="status-badge status-active">Active</span>
                                    {% else %}
                                        <span class="status-badge status-inactive">Inactive</span>
                                    {% endif %}
                                </td>
                                     <td class="sem-table-td date-cell">
                                    {% if user.createdAt %}                                      
                                    {{ user.createdAt|date('F j, Y g:i A') }}   {# January 15, 2024 2:30 PM #}
                                    {% else %}
                                        <span style="color: #9ca3af; font-style: italic;">Not set</span>
                                    {% endif %}
                                </td>
                                <td class="sem-table-td sem-actions-td">
                                    <div class="action-buttons">
                                        <a href="{{ path('app_user_show', {'id': user.id}) }}" class="btn-view">View</a>
                                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn-edit">Edit</a>
                                        
                                        {% if is_granted('ROLE_ADMIN') and user.id != app.user.id %}
                                            <form method="post" action="{{ path('app_user_toggle_status', {'id': user.id}) }}" 
                                                  style="display: inline;" 
                                                  onsubmit="return confirm('Are you sure you want to {{ user.isActive ? 'deactivate' : 'activate' }} {{ user.username }}?')">
                                                <input type="hidden" name="_token" value="{{ csrf_token('toggle_status' ~ user.id) }}">
                                                <button type="submit" class="{{ user.isActive ? 'btn-deactivate' : 'btn-activate' }}">
                                                    {{ user.isActive ? 'Deactivate' : 'Activate' }}
                                                </button>
                                            </form>
                                        {% endif %}
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr class="sem-empty-row">
                                <td colspan="6" class="sem-empty-td">
                                    No users found. <a href="{{ path('app_user_new') }}" class="sem-link">Create the first user</a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="sem-new-btn-container">
                    <a href="{{ path('app_user_new') }}" class="sem-btn sem-create-btn">Add New User</a>
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <!-- jQuery and DataTables JS (add if not in base.html.twig) -->
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    
    <script>
    document.addEventListener('DOMContentLoaded', function() {
        // Initialize DataTable
        if ($.fn.DataTable) {
            $('#userTable').DataTable({
                responsive: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                order: [[0, 'desc']], // Default sort by ID descending
                language: {
                    search: "_INPUT_",
                    searchPlaceholder: "Search users...",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ entries",
                    infoEmpty: "No users found",
                    infoFiltered: "(filtered from _MAX_ total users)",
                    zeroRecords: "No matching users found",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Previous"
                    }
                },
                columnDefs: [
                    {
                        targets: 5, // Actions column
                        orderable: false,
                        searchable: false,
                        className: 'dt-body-right sem-actions-td'
                    },
                    {
                        targets: 0, // ID column
                        className: 'dt-body-left'
                    },
                    {
                        targets: [1, 2, 3, 4], // Other columns
                        className: 'dt-body-left'
                    },
                    {
                        targets: 4, // Created At column
                        type: 'date', // Enable date sorting
                        render: function(data, type, row) {
                            if (type === 'sort') {
                                // Return timestamp for sorting
                                return new Date(data).getTime();
                            }
                            return data;
                        }
                    },
                    {
                        targets: 3, // Status column
                        render: function(data, type, row) {
                            if (type === 'sort' || type === 'type') {
                                return data.includes('Active') ? 1 : 0;
                            }
                            return data;
                        }
                    }
                ],
                initComplete: function() {
                    // Add custom classes to DataTable elements
                    $('.dataTables_wrapper').addClass('sem-datatable-wrapper');
                    $('.dataTables_length').addClass('sem-dt-length');
                    $('.dataTables_filter').addClass('sem-dt-filter');
                    $('.dataTables_info').addClass('sem-dt-info');
                    $('.dataTables_paginate').addClass('sem-dt-paginate');
                    
                    // Style the search input
                    $('.dataTables_filter input').addClass('sem-dt-search');
                    
                    // Style the length select
                    $('.dataTables_length select').addClass('sem-dt-select');
                    
                    // Style pagination buttons
                    $('.paginate_button').addClass('sem-paginate-btn');
                    $('.paginate_button.current').addClass('sem-paginate-current');
                    
                    // Ensure Actions header is right-aligned
                    $('th.sem-actions-col').css('text-align', 'right');
                },
                drawCallback: function() {
                    // Reapply hover effects after DataTable redraws
                    $('.sem-table tbody tr').hover(
                        function() {
                            $(this).addClass('sem-row-hover');
                        },
                        function() {
                            $(this).removeClass('sem-row-hover');
                        }
                    );
                    
                    // Ensure action buttons are right-aligned in each row
                    $('td.sem-actions-td .action-buttons').css('justify-content', 'flex-end');
                }
            });
            
            // Add custom hover effect
            $('.sem-table tbody').on('mouseenter', 'tr', function() {
                $(this).addClass('sem-row-hover');
            }).on('mouseleave', 'tr', function() {
                $(this).removeClass('sem-row-hover');
            });
            
        } else {
            console.warn('DataTables not loaded, using basic functionality');
            
            // Fallback hover effects
            const tableRows = document.querySelectorAll('.sem-table tbody tr');
            tableRows.forEach(row => {
                row.addEventListener('mouseenter', () => {
                    row.classList.add('sem-row-hover');
                });
                
                row.addEventListener('mouseleave', () => {
                    row.classList.remove('sem-row-hover');
                });
            });
            
            // Ensure action buttons are right-aligned
            document.querySelectorAll('.sem-actions-td .action-buttons').forEach(buttons => {
                buttons.style.justifyContent = 'flex-end';
            });
        }
        
        // Add time ago functionality
        function updateTimeAgo() {
            document.querySelectorAll('.date-cell').forEach(cell => {
                const dateText = cell.textContent.trim();
                if (dateText && dateText !== 'Not set') {
                    const date = new Date(dateText);
                    const now = new Date();
                    const diffMs = now - date;
                    const diffDays = Math.floor(diffMs / (1000 * 60 * 60 * 24));
                    const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
                    const diffMinutes = Math.floor(diffMs / (1000 * 60));
                    
                    let agoText = '';
                    if (diffDays > 0) {
                        agoText = `${diffDays} day${diffDays > 1 ? 's' : ''} ago`;
                    } else if (diffHours > 0) {
                        agoText = `${diffHours} hour${diffHours > 1 ? 's' : ''} ago`;
                    } else if (diffMinutes > 0) {
                        agoText = `${diffMinutes} minute${diffMinutes > 1 ? 's' : ''} ago`;
                    } else {
                        agoText = 'Just now';
                    }
                    
                    // Add tooltip with full date
                    cell.title = `Created: ${dateText}`;
                    
                    // Optional: Add a small "ago" text
                    const agoSpan = document.createElement('small');
                    agoSpan.style.display = 'block';
                    agoSpan.style.fontSize = '0.75rem';
                    agoSpan.style.color = '#9ca3af';
                    agoSpan.style.marginTop = '0.125rem';
                    agoSpan.textContent = agoText;
                    
                    // Clear and add new content
                    cell.innerHTML = dateText;
                    cell.appendChild(agoSpan);
                }
            });
        }
        
        // Run time ago update
        updateTimeAgo();
    });
    </script>
{% endblock %}