{% extends 'base.html.twig' %}

{% block title %}User Details{% endblock %}

{% block body %}
<style>
  .dashboard-container {
    display: flex;
    min-height: 100vh;
  }

  .main-content {
    flex: 1;
    padding: 1.5rem;
  }

  h1 {
    margin-bottom: 1rem;
    font-size: 1.5rem;
    color: #92400e;
  }

  .details-card {
    background: white;
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    padding: 1.5rem;
    max-width: 800px;
    margin: 0 auto;
    overflow: hidden;
  }

  .details-table {
    width: 100%;
    border-collapse: collapse;
  }

  .details-table th,
  .details-table td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid #e5e7eb;
    vertical-align: top;
  }

  .details-table th {
    background-color: #f3f4f6;
    font-weight: 600;
    width: 200px;
  }

  /* ===== Buttons ===== */
  .btn {
    padding: 0.5rem 1rem;
    font-size: 0.9rem;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    color: white;
    display: inline-block;
    text-align: center;
    transition: background-color 0.3s ease;
  }

  .back-btn {
    background-color: #92400e; /* brown */
    margin-right: 8px;
  }
  .back-btn:hover {
    background-color: #78350f;
  }

  .edit-btn {
    background-color: #d97706; /* orange */
    margin-right: 8px;
  }
  .edit-btn:hover {
    background-color: #b45309;
  }

  .delete-btn {
    background-color: #b91c1c; /* red */
  }
  .delete-btn:hover {
    background-color: #991b1b;
  }

  .actions-container {
    margin-top: 1.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }

  @media (max-width: 768px) {
    .details-card {
      padding: 1rem;
    }
    .details-table th, .details-table td {
      font-size: 0.85rem;
      display: block;
      width: 100%;
    }
    .details-table th {
      background-color: transparent;
      padding-top: 1rem;
      font-weight: 700;
    }
    .details-table td {
      padding-bottom: 1rem;
    }
  }
</style>

<div class="dashboard-container">
  {% include 'Dashboard/sidebar.html.twig' %}

  <main class="main-content">
    <h1>User Details</h1>

    <div class="details-card">
      <table class="details-table">
        <tbody>
          <tr>
            <th>ID</th>
            <td>{{ user.id }}</td>
          </tr>
          <tr>
            <th>Name</th>
            <td>{{ user.name }}</td>
          </tr>
          <tr>
            <th>Email</th>
            <td>{{ user.email }}</td>
          </tr>
          <tr>
            <th>Address</th>
            <td>{{ user.address }}</td>
          </tr>
          <tr>
            <th>Phone</th>
            <td>{{ user.phone }}</td>
          </tr>
          <tr>
            <th>Password (Hashed)</th>
            <td>{{ user.password }}</td>
          </tr>
        </tbody>
      </table>

      <div class="actions-container">
        <a href="{{ path('app_user_index') }}" class="btn back-btn">← Back to List</a>
        <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="btn edit-btn">✏️ Edit</a>
        {{ include('user/_delete_form.html.twig', { 'button_label': 'Delete', 'attr': { 'class': 'btn delete-btn' } }) }}
      </div>
    </div>
  </main>
</div>
{% endblock %}
