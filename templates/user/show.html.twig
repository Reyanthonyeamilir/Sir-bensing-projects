{% extends 'base.html.twig' %}
 
{% block title %}User Details{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/user/crud.css') }}">
{% endblock %}

{% block body %}
<div class="user-crud">
    {% include 'dashboard/sidebar.html.twig' %}

    <main class="main-content">
        <div class="sem-container">
            <div class="sem-header">
                <h1>User Details</h1>
            </div>
            
            <div class="sem-content">
                <div class="sem-info-display">
                    <div class="sem-info-row">
                        <span class="sem-info-label">User ID:</span>
                        <span class="sem-info-value">#{{ user.id }}</span>
                    </div>
                    <div class="sem-info-row">
                        <span class="sem-info-label">Username:</span>
                        <span class="sem-info-value">{{ user.username }}</span>
                    </div>
                    <div class="sem-info-row">
                        <span class="sem-info-label">Roles:</span>
                        <div class="sem-info-value">
                            {% for role in user.roles %}
                                {% if role == 'ROLE_ADMIN' %}
                                    <span class="sem-role-badge sem-role-badge-admin">Admin</span>
                                {% elseif role == 'ROLE_staff' %}
                                    <span class="sem-role-badge sem-role-badge-staff">Staff</span>
                                {% elseif role == 'ROLE_USER' %}
                                    <span class="sem-role-badge sem-role-badge-user">User</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    <div class="sem-info-row">
                        <span class="sem-info-label">Password Hash:</span>
                        <div class="sem-info-value">
                            <span class="sem-password-hash">{{ user.password|slice(0, 20) }}...</span>
                            <div class="sem-password-note">(hashed - not readable)</div>
                        </div>
                    </div>
                </div>

                <div class="sem-action-buttons">
                    <a href="{{ path('app_user_index') }}" class="sem-btn sem-btn-outline">
                        <span>←</span> Back to List
                    </a>
                    <a href="{{ path('app_user_edit', {'id': user.id}) }}" class="sem-btn sem-btn-primary">
                        <span>✏️</span> Edit User
                    </a>
                    {{ include('user/_delete_form.html.twig') }}
                </div>
            </div>
        </div>
    </main>
</div>
{% endblock %}