{% extends 'base.html.twig' %}

{% block title %}My Profile{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* OPTIMIZED STYLES - Performance Focused */
        :root {
            --primary-color: #cc5404;
            --primary-dark: #a63d03;
            --secondary-color: #8B4513;
            --accent-light: #d4a574;
            --bg-light: #f9f5f0;
            --bg-lighter: #fefefe;
            --border-light: #e9d8c8;
            --shadow-light: 0 2px 8px rgba(0,0,0,0.1);
        }

        .dashboard-container {
            display: flex;
            min-height: 100vh;
            background: #f8f9fa;
        }

        /* Optimized main content area */
        .main-content {
            flex: 1;
            padding: 2rem;
            margin-left: 280px; /* Match sidebar width */
            box-sizing: border-box;
            min-height: 100vh;
        }

        /* Profile container - simplified styles */
        .profile-container {
            width: 100%;
            max-width: 600px;
            margin: 0 auto;
            background: white;
            border-radius: 12px;
            padding: 2rem;
            contain: layout paint style; /* Performance optimization */
        }

        .profile-header {
            text-align: center;
            margin-bottom: 2rem;
            padding-bottom: 1.5rem;
            border-bottom: 1px solid #eee;
        }

        .profile-header h1 {
            color: var(--primary-color);
            font-weight: 700;
            font-size: 1.8rem;
            margin: 0 0 0.5rem 0;
        }

        /* Optimized avatar - hardware accelerated */
        .user-avatar {
            width: 100px;
            height: 100px;
            background: linear-gradient(135deg, var(--primary-color), #ff6b35);
            border-radius: 50%;
            margin: 0 auto 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 2.5rem;
            font-weight: 600;
            will-change: transform;
            transform: translateZ(0); /* GPU acceleration */
        }

        /* Simplified form styles */
        .form-group {
            margin-bottom: 1.5rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            color: var(--secondary-color);
            font-weight: 600;
            font-size: 0.95rem;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid var(--accent-light);
            border-radius: 8px;
            font-size: 0.95rem;
            color: var(--secondary-color);
            background: var(--bg-lighter);
            transition: border-color 0.2s ease;
            box-sizing: border-box;
            -webkit-appearance: none; /* Remove iOS styling */
            appearance: none;
        }

        .form-control:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(204, 84, 4, 0.1);
        }

        /* Password fields section */
        .password-fields {
            background: var(--bg-light);
            padding: 1.5rem;
            border-radius: 8px;
            margin: 2rem 0;
            border: 1px solid var(--border-light);
        }

        .password-fields h3 {
            color: var(--secondary-color);
            margin: 0 0 1rem 0;
            font-size: 1.1rem;
            font-weight: 600;
        }

        /* Optimized buttons */
        .btn {
            padding: 0.9rem 2rem;
            font-size: 1rem;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            text-decoration: none;
            color: white;
            display: inline-block;
            text-align: center;
            font-weight: 600;
            transition: background-color 0.2s ease;
            background-color: var(--primary-color);
            width: 100%;
            margin-top: 1rem;
            box-sizing: border-box;
            position: relative;
            overflow: hidden;
        }

        .btn::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 5px;
            height: 5px;
            background: rgba(255, 255, 255, 0.5);
            opacity: 0;
            border-radius: 100%;
            transform: scale(1, 1) translate(-50%);
            transform-origin: 50% 50%;
        }

        .btn:focus:not(:active)::after {
            animation: ripple 1s ease-out;
        }

        @keyframes ripple {
            0% {
                transform: scale(0, 0);
                opacity: 0.5;
            }
            100% {
                transform: scale(20, 20);
                opacity: 0;
            }
        }

        .btn:hover {
            background-color: var(--primary-dark);
        }

        .btn-secondary {
            background-color: #6c757d;
            margin-top: 0.5rem;
        }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

        /* User info section - optimized */
        .user-info {
            background: var(--bg-light);
            padding: 1.5rem;
            border-radius: 8px;
            margin-bottom: 2rem;
            border: 1px solid var(--border-light);
        }

        .info-item {
            display: flex;
            justify-content: space-between;
            margin-bottom: 0.75rem;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid var(--border-light);
        }

        .info-item:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .info-label {
            color: var(--secondary-color);
            font-weight: 600;
            font-size: 0.9rem;
        }

        .info-value {
            color: var(--secondary-color);
            font-size: 0.9rem;
            text-align: right;
            word-break: break-word; /* Prevent overflow */
        }

        .role-badge {
            display: inline-block;
            padding: 0.3rem 0.75rem;
            background: #e9ecef;
            border-radius: 6px;
            font-size: 0.8rem;
            margin: 0.2rem;
            color: var(--secondary-color);
            border: 1px solid var(--accent-light);
        }

        .button-container {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            margin-top: 1.5rem;
        }

        /* Alert styles - simplified */
        .alert {
            padding: 1rem 1.25rem;
            border-radius: 8px;
            margin-bottom: 1.5rem;
            border: 1px solid transparent;
            animation: slideIn 0.3s ease-out;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .alert-success {
            color: #0f5132;
            background-color: #d1e7dd;
            border-color: #badbcc;
        }

        .alert-error {
            color: #842029;
            background-color: #f8d7da;
            border-color: #f5c2c7;
        }

        .alert-info {
            color: #055160;
            background-color: #cff4fc;
            border-color: #b6effb;
        }

        /* Responsive design - mobile first approach */
        @media (max-width: 1199px) {
            .main-content {
                margin-left: 0;
                padding-top: 6rem; /* Make space for mobile header */
            }
        }

        @media (max-width: 768px) {
            .main-content {
                padding: 1rem;
                padding-top: 5rem;
            }
            
            .profile-container {
                padding: 1.25rem;
                border-radius: 8px;
            }
            
            .user-avatar {
                width: 80px;
                height: 80px;
                font-size: 2rem;
            }
            
            .password-fields,
            .user-info {
                padding: 1rem;
            }
            
            .btn {
                padding: 0.8rem 1rem;
                font-size: 0.95rem;
            }
        }

        /* Touch device optimizations */
        @media (hover: none) and (pointer: coarse) {
            .btn {
                min-height: 44px; /* Apple recommended touch target */
            }
            
            .form-control {
                font-size: 16px; /* Prevent iOS zoom */
                min-height: 44px;
            }
        }

        /* Reduced motion preference */
        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
            }
            
            .alert {
                animation: none;
            }
            
            .btn:hover {
                transform: none;
            }
        }

        /* Print styles */
        @media print {
            .btn,
            .password-fields,
            .form-group {
                display: none !important;
            }
            
            .profile-container {
                box-shadow: none;
                max-width: 100%;
            }
        }
    </style>
{% endblock %}

{% block body %}
    {% include 'dashboard/sidebar.html.twig' %}
    
    <div class="dashboard-container">
        <div class="main-content">
            <div class="profile-container">
                <!-- Flash Messages -->
                {% for message in app.flashes('success') %}
                    <div class="alert alert-success" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
                
                {% for message in app.flashes('error') %}
                    <div class="alert alert-error" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}
                
                {% for message in app.flashes('info') %}
                    <div class="alert alert-info" role="alert">
                        {{ message }}
                    </div>
                {% endfor %}

                <div class="profile-header">
                    <div class="user-avatar" aria-label="User avatar">
                        {{ user.username|first|upper }}
                    </div>
                    <h1>My Profile</h1>
                    <div class="subtitle">Manage your account settings</div>
                </div>

                <!-- User Information -->
                <div class="user-info">
                    <div class="info-item">
                        <span class="info-label">User ID:</span>
                        <span class="info-value">#{{ user.id }}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Current Username:</span>
                        <span class="info-value">{{ user.username }}</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Roles:</span>
                        <div class="info-value">
                            {% for role in user.roles %}
                                {% if role != 'ROLE_USER' or user.roles|length == 1 %}
                                    <span class="role-badge">{{ role|replace({'ROLE_': ''})|lower|title }}</span>
                                {% endif %}
                            {% endfor %}
                        </div>
                    </div>
                    <div class="info-item">
                        <span class="info-label">Account Created:</span>
                        <span class="info-value">Not available</span>
                    </div>
                </div>

                <!-- Edit Form -->
                {{ form_start(form, {'attr': {'class': 'profile-form', 'novalidate': 'novalidate'}}) }}
                
                    <div class="form-group">
                        {{ form_label(form.username) }}
                        {{ form_widget(form.username, {'attr': {
                            'class': 'form-control',
                            'autocomplete': 'username',
                            'aria-describedby': 'usernameHelp'
                        }}) }}
                        {{ form_errors(form.username) }}
                        <small id="usernameHelp" class="form-help">Choose a unique username that others will see</small>
                    </div>

                    <div class="password-fields">
                        <h3>Change Password</h3>
                        
                        <div class="form-group">
                            {{ form_label(form.currentPassword) }}
                            {{ form_widget(form.currentPassword, {'attr': {
                                'class': 'form-control',
                                'autocomplete': 'current-password',
                                'aria-describedby': 'currentPasswordHelp'
                            }}) }}
                            {{ form_errors(form.currentPassword) }}
                            <small id="currentPasswordHelp" class="form-help">Enter your current password to authorize changes</small>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.newPassword) }}
                            {{ form_widget(form.newPassword, {'attr': {
                                'class': 'form-control',
                                'autocomplete': 'new-password',
                                'aria-describedby': 'newPasswordHelp'
                            }}) }}
                            {{ form_errors(form.newPassword) }}
                            <small id="newPasswordHelp" class="form-help">Minimum 8 characters, recommended to use a strong password</small>
                        </div>

                        <div class="form-group">
                            {{ form_label(form.confirmPassword) }}
                            {{ form_widget(form.confirmPassword, {'attr': {
                                'class': 'form-control',
                                'autocomplete': 'new-password',
                                'aria-describedby': 'confirmPasswordHelp'
                            }}) }}
                            {{ form_errors(form.confirmPassword) }}
                            <small id="confirmPasswordHelp" class="form-help">Re-enter your new password for confirmation</small>
                        </div>
                    </div>

                    <div class="button-container">
                        <button type="submit" class="btn" aria-label="Update profile">
                            <span aria-hidden="true">💾</span> Update Profile
                        </button>
                        
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_user_index') }}" class="btn btn-secondary" aria-label="Back to users list">
                            <span aria-hidden="true">←</span> Back to Users
                        </a>
                        {% endif %}
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            'use strict';
            
            // Cache DOM elements
            const newPassword = document.querySelector('#{{ form.newPassword.vars.id }}');
            const confirmPassword = document.querySelector('#{{ form.confirmPassword.vars.id }}');
            const currentPassword = document.querySelector('#{{ form.currentPassword.vars.id }}');
            
            // Password validation with debouncing
            let passwordValidationTimeout;
            
            function validatePasswordMatch() {
                clearTimeout(passwordValidationTimeout);
                passwordValidationTimeout = setTimeout(() => {
                    if (newPassword && confirmPassword && newPassword.value && confirmPassword.value) {
                        if (newPassword.value !== confirmPassword.value) {
                            confirmPassword.setCustomValidity('Passwords do not match');
                            confirmPassword.reportValidity();
                        } else {
                            confirmPassword.setCustomValidity('');
                        }
                    }
                }, 300);
            }
            
            // Add event listeners with passive where possible
            if (newPassword && confirmPassword) {
                newPassword.addEventListener('input', validatePasswordMatch, { passive: true });
                confirmPassword.addEventListener('input', validatePasswordMatch, { passive: true });
            }
            
            // Real-time password strength indicator
            function checkPasswordStrength(password) {
                let strength = 0;
                if (password.length >= 8) strength++;
                if (/[A-Z]/.test(password)) strength++;
                if (/[0-9]/.test(password)) strength++;
                if (/[^A-Za-z0-9]/.test(password)) strength++;
                return strength;
            }
            
            if (newPassword) {
                newPassword.addEventListener('input', function() {
                    const strength = checkPasswordStrength(this.value);
                    // You could update a visual indicator here
                }, { passive: true });
            }
            
            // Auto-focus first invalid input on form submission
            const form = document.querySelector('.profile-form');
            if (form) {
                form.addEventListener('invalid', function(e) {
                    e.preventDefault();
                    const invalidInputs = form.querySelectorAll(':invalid');
                    if (invalidInputs.length > 0) {
                        invalidInputs[0].focus();
                    }
                }, true);
                
                // Prevent double form submission
                let isSubmitting = false;
                form.addEventListener('submit', function(e) {
                    if (isSubmitting) {
                        e.preventDefault();
                        return;
                    }
                    isSubmitting = true;
                    
                    // Disable submit button
                    const submitBtn = form.querySelector('button[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML = '<span aria-hidden="true">⏳</span> Updating...';
                    }
                });
            }
            
            // Auto-hide alerts after 5 seconds
            const alerts = document.querySelectorAll('.alert');
            alerts.forEach(alert => {
                setTimeout(() => {
                    alert.style.transition = 'opacity 0.5s ease';
                    alert.style.opacity = '0';
                    setTimeout(() => alert.remove(), 500);
                }, 5000);
            });
            
            // Improve form accessibility
            const formControls = document.querySelectorAll('.form-control');
            formControls.forEach(control => {
                control.addEventListener('focus', function() {
                    this.parentElement.classList.add('focused');
                });
                
                control.addEventListener('blur', function() {
                    this.parentElement.classList.remove('focused');
                });
            });
        });
    </script>
{% endblock %}