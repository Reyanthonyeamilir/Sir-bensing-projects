{% extends 'base.html.twig' %}

{% block title %}Create New User{% endblock %}

{% block stylesheets %}
  <style>
    html, body {
      min-height: 100%;
      margin: 0;
      background: #f8f9fa; /* light neutral background */
      overflow-x: hidden;
    }

    .dashboard-container {
      display: flex;
      min-height: 100vh;
    }

    /* ✅ Main area next to sidebar */
    .create-container {
      flex: 1;
      display: flex;
      justify-content: flex-start; /* align left */
      padding: 2rem;
    }

    .create-card {
      width: 100%;
      max-width: 650px;
      background: #ffffff;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
      display: flex;
      flex-direction: column;
      border-radius: 8px;
    }

    .create-card h1 {
      color: #cc5404;
      font-weight: 700;
      font-size: 1.8rem;
      text-align: center;
      padding: 1rem;
      border-bottom: 1px solid #eee;
      margin: 0;
    }

    .form-scroll {
      padding: 1.5rem 2rem;
      background: #ffffff;
    }

    form {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    form input,
    form select,
    form textarea {
      width: 100%;
      padding: 0.7rem 1rem;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 1rem;
      background: #fff;
      transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

    form input:focus,
    form select:focus,
    form textarea:focus {
      outline: none;
      border-color: #cc5404;
      box-shadow: 0 0 5px rgba(204, 84, 4, 0.3);
    }

    .btn-group {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 1.5rem;
    }

    .btn-submit {
      background: #cc5404;
      color: #fff;
      padding: 0.8rem 1.5rem;
      border: none;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s ease, transform 0.2s ease;
    }

    .btn-submit:hover {
      background: #a63d03;
      transform: translateY(-2px);
    }

    .btn-back {
      color: #333;
      text-decoration: none;
      font-weight: 500;
      transition: color 0.3s ease;
    }

    .btn-back:hover {
      color: #cc5404;
    }

    @media (max-width: 768px) {
      .dashboard-container {
        flex-direction: column;
      }

      .create-container {
        padding: 1rem;
      }

      .create-card {
        max-width: 100%;
      }
    }
  </style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
  {% include 'dashboard/sidebar.html.twig' %}

  <div class="create-container">
    <div class="create-card">
      <h1>Create New User</h1>

      <div class="form-scroll">
        {{ include('user/_form.html.twig') }}

        <div class="btn-group">
          <a href="{{ path('app_user_index') }}" class="btn-back">← Back to list</a>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
