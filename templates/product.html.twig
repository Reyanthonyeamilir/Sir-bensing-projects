{% extends 'base.html.twig' %}

{% block title %}Pet Products{% endblock %}

{% block stylesheets %}
  <link rel="stylesheet" href="{{ asset('styles/product.css') }}">
    {{ encore_entry_link_tags('app') }}
{% endblock %}

{% block body %}
<div class="product-layout">


  <!-- SIDEBAR -->
  <aside class="sidebar">
  <h2 class="sidebar-title">Categories</h2>
  <ul class="category-list">

    {% set seenCategories = [] %}
    {% set categories = [] %}
    {% for p in allProducts %}
      {% if p.category not in seenCategories %}
        {% set categories = categories|merge([p.category]) %}
        {% set seenCategories = seenCategories|merge([p.category]) %}
      {% endif %}
    {% endfor %}

    {% for category in categories %}
      <li class="category-item">
        <button class="category-toggle" data-target="sub-{{ loop.index }}">
          <span class="icon">🐾</span>
          <span class="label">{{ category }}</span>
          <span class="arrow">›</span>
        </button>

        {% set seenSubs = [] %}
        {% set subcats = [] %}
        {% for p in allProducts %}
          {% if p.category == category and p.subCategory not in seenSubs %}
            {% set subcats = subcats|merge([p.subCategory]) %}
            {% set seenSubs = seenSubs|merge([p.subCategory]) %}
          {% endif %}
        {% endfor %}

        {% if subcats is not empty %}
          <ul class="subcategory-list" id="sub-{{ loop.index }}">
            {% for sub in subcats %}
              <li>
                <a href="{{ path('product', {'category': category, 'subCategory': sub}) }}"
                   class="subcategory-link {% if sub == currentSubCategory %}active{% endif %}">
                  <span class="icon">🐾</span> {{ sub }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.category-toggle').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.target;
        const list = document.getElementById(id);
        list.classList.toggle('open');
        btn.classList.toggle('open');
      });
    });
  });
</script>

  <!-- MAIN PRODUCT LIST -->
  <main class="product-page">
    <h1 class="page-title">🐾 Pet Products</h1>

    <div class="product-grid">
      {% for petproduct in petproducts %}
        <div class="product-card">
          <div class="image-container">
            {% if petproduct.imageUrl %}
              <img src="{{ asset('uploads/' ~ petproduct.imageUrl) }}" alt="{{ petproduct.productName }}">
            {% else %}
              <img src="{{ asset('images/no-image.png') }}" alt="No Image">
            {% endif %}
          </div>
          <div class="product-info">
            <h3 class="product-name">{{ petproduct.productName}}</h3>
            <p class="category">{{ petproduct.category }} — {{ petproduct.subCategory }}</p>
            <p class="price">$ {{ petproduct.price }}</p>
            <p class="brand">Brand: {{ petproduct.brand }}</p>
            <div class="button-group">
              <a href="{{ path('product_view', {'id': petproduct.id}) }}" class="btn view-btn">View</a>
            </div>
          </div>
        </div>
      {% else %}
        <p class="no-products">No products found.</p>
      {% endfor %}
    </div>
  </main>
</div>
{% endblock %}
