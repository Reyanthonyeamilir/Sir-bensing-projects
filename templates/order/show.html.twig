{# templates/order/show.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Order Details - #{{ order.id }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  
  body, html { 
    background: transparent !important; 
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
  }
  
  .dashboard-container { 
    display: flex; 
    min-height: 100vh; 
    background: transparent; 
  }
  
  .main-content { 
    flex: 1; 
    padding: 1.5rem; 
    background: transparent; 
    margin-left: 280px; 
    max-width: calc(100% - 280px);
  }
  
  .order-heading { 
    font-size: 1.6rem; 
    font-weight: 700; 
    color: #e9d311c5; 
    margin-bottom: 1.5rem; 
    text-align: center; 
    padding-bottom: 0.8rem;
    border-bottom: 2px solid #ff7b35;
  }
  
  .order-card {
    background: rgba(255, 255, 255, 0.95);
    border-radius: 10px;
    box-shadow: 0 3px 10px rgba(0,0,0,0.1);
    padding: 2rem;
    max-width: 800px;
    margin: 0 auto;
  }
  
  .order-id {
    font-size: 1.8rem;
    font-weight: 700;
    color: #cc5404;
    text-align: center;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #eee;
  }
  
  .order-details-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  
  .order-section {
    background: #f9f9f9;
    border-radius: 8px;
    padding: 1.5rem;
    border-left: 4px solid #ff7b35;
  }
  
  .section-title {
    font-size: 1rem;
    font-weight: 600;
    color: #555;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .detail-row {
    display: flex;
    justify-content: space-between;
    padding: 0.6rem 0;
    border-bottom: 1px solid #eee;
  }
  
  .detail-row:last-child {
    border-bottom: none;
  }
  
  .detail-label {
    font-weight: 500;
    color: #666;
  }
  
  .detail-value {
    font-weight: 600;
    color: #333;
  }
  
  .status-badge {
    display: inline-block;
    padding: 0.4rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
  
  .status-pending {
    background-color: #ffc107;
    color: #856404;
  }
  
  .status-processing {
    background-color: #17a2b8;
    color: white;
  }
  
  .status-completed {
    background-color: #28a745;
    color: white;
  }
  
  .status-cancelled {
    background-color: #dc3545;
    color: white;
  }
  
  .amount-highlight {
    font-size: 1.2rem;
    font-weight: 700;
    color: #cc5404;
  }
  
  .product-highlight {
    background: #fff5e6;
    padding: 0.8rem;
    border-radius: 6px;
    margin-top: 0.5rem;
    border-left: 3px solid #ff7b35;
  }
  
  .product-highlight .detail-label {
    color: #cc5404;
  }
  
  .order-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #eee;
  }
  
  .btn {
    padding: 0.6rem 1.2rem;
    font-size: 0.9rem;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    text-decoration: none;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    font-weight: 500;
    min-width: 120px;
  }
  
  .btn:hover { 
    transform: translateY(-2px); 
    box-shadow: 0 2px 5px rgba(0,0,0,0.1);
  }
  
  .edit-btn { 
    background-color: #5a3922; 
  }
  
  .edit-btn:hover { 
    background-color: #4a2e1b; 
  }
  
  .back-btn { 
    background-color: #6c757d; 
  }
  
  .back-btn:hover { 
    background-color: #5a6268; 
  }
  
  .delete-btn { 
    background-color: #dc3545; 
  }
  
  .delete-btn:hover { 
    background-color: #c82333; 
  }
  
  .btn.disabled {
    background-color: #6c757d;
    color: #adb5bd;
    cursor: not-allowed;
    opacity: 0.65;
  }
  
  .btn.disabled:hover {
    transform: none;
    box-shadow: none;
  }
  
  .btn::before {
    margin-right: 0.5rem;
  }
  
  .edit-btn::before {
    content: "✎";
  }
  
  .back-btn::before {
    content: "←";
  }
  
  .delete-btn::before {
    content: "🗑";
  }
  
  .delete-form {
    margin-top: 1rem;
    text-align: center;
  }
  
  @media (max-width: 768px) {
    .main-content {
      margin-left: 0;
      max-width: 100%;
      padding: 1rem;
    }
    
    .order-card {
      padding: 1.5rem;
    }
    
    .order-details-grid {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    
    .order-actions {
      flex-direction: column;
    }
    
    .btn {
      width: 100%;
      margin-bottom: 0.5rem;
    }
  }
</style>
{% endblock %}

{% block body %}
<div class="dashboard-container">
    {% include 'dashboard/sidebar.html.twig' %}
    
    <div class="main-content">
        <h1 class="order-heading">Order Details</h1>
        
        <div class="order-card">
            <div class="order-id">Order #{{ order.id }}</div>
            
            {% set canEdit = is_granted('ROLE_ADMIN') or is_granted('ROLE_staff') %}
            {% set canDelete = is_granted('ROLE_ADMIN') or is_granted('ROLE_staff') %}
            
            <div class="order-details-grid">
                <div class="order-section">
                    <h3 class="section-title">Order Information</h3>
                    <div class="detail-row">
                        <span class="detail-label">Order ID:</span>
                        <span class="detail-value">#{{ order.id }}</span>
                    </div>
                    {# Update the status badge section #}
<div class="detail-row">
    <span class="detail-label">Status:</span>
    <span class="detail-value">
        {% if order.status == 'pending' %}
            <span class="status-badge status-pending">{{ order.status }}</span>
        {% elseif order.status == 'completed' %}
            <span class="status-badge status-completed">{{ order.status }}</span>
        {% else %}
            <span class="status-badge">{{ order.status }}</span>
        {% endif %}
    </span>
</div>
                    <div class="detail-row">
                        <span class="detail-label">Quantity:</span>
                        <span class="detail-value">{{ order.quantity }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Total Amount:</span>
                        <span class="detail-value amount-highlight">₱{{ order.amount|number_format(2) }}</span>
                    </div>
                </div>
                
                <div class="order-section">
                    <h3 class="section-title">Customer Details</h3>
                    <div class="detail-row">
                        <span class="detail-label">Customer:</span>
                        <span class="detail-value">{{ order.customer.username }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Account Created:</span>
                        <span class="detail-value">{{ order.customer.createdAt|date('M d, Y') }}</span>
                    </div>
                </div>
                
                <div class="order-section product-highlight">
                    <h3 class="section-title">Product Details</h3>
                <div class="detail-row">
    <span class="detail-label">Product:</span>
    <span class="detail-value">{{ order.product.productName }}</span>
</div>
                    <div class="detail-row">
                        <span class="detail-label">Category:</span>
                        <span class="detail-value">{{ order.product.category }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Price:</span>
                        <span class="detail-value">₱{{ order.product.price|number_format(2) }}</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Brand:</span>
                        <span class="detail-value">{{ order.product.brand ?: 'N/A' }}</span>
                    </div>
                </div>
                
                <div class="order-section">
                    <h3 class="section-title">Timestamps</h3>
                    <div class="detail-row">
                        <span class="detail-label">Order Created:</span>
                        <span class="detail-value">{{ order.createdAt|date('F j, Y g:i A') }}</span>
                    </div>
                    {% if order.updatedAt %}
                    <div class="detail-row">
                        <span class="detail-label">Last Updated:</span>
                        <span class="detail-value">{{ order.updatedAt|date('F j, Y g:i A') }}</span>
                    </div>
                    {% endif %}
                </div>
            </div>
            
            <div class="order-actions">
                {% if canEdit %}
                    <a href="{{ path('app_order_edit', {'id': order.id}) }}" class="btn edit-btn">Edit Order</a>
                {% else %}
                    <button class="btn edit-btn disabled" title="Edit not allowed">Edit Order</button>
                {% endif %}
                
                <a href="{{ path('app_order_index') }}" class="btn back-btn">Back to Orders</a>
            </div>
            
            <div class="delete-form">
                {% if canDelete %}
                    <form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" 
                          onsubmit="return confirm('Are you sure you want to delete order #{{ order.id }}? This action cannot be undone.');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
                        <button type="submit" class="btn delete-btn">Delete Order</button>
                    </form>
                {% else %}
                    <button class="btn delete-btn disabled" title="Delete not allowed">Delete Order</button>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}