{# templates/order/_form.html.twig #}
{{ form_start(form, {'attr': {'class': 'sem-form'}}) }}
    
    <div class="sem-form-group">
        {{ form_label(form.customer) }}
        {{ form_widget(form.customer, {'attr': {'class': 'sem-form-input'}}) }}
        {{ form_errors(form.customer) }}
        <small class="sem-form-text">Select the customer for this order</small>
    </div>

    <div class="sem-form-group">
        {{ form_label(form.product) }}
        {{ form_widget(form.product, {'attr': {'class': 'sem-form-input'}}) }}
        {{ form_errors(form.product) }}
        <small class="sem-form-text">Select the product to order (only active products with stock > 0 are shown)</small>
    </div>

    <div class="sem-form-group">
        {{ form_label(form.quantity) }}
        {{ form_widget(form.quantity, {'attr': {'class': 'sem-form-input'}}) }}
        {{ form_errors(form.quantity) }}
        <small class="sem-form-text">Enter quantity of products</small>
    </div>

    <div class="sem-form-group">
        {{ form_label(form.status) }}
        {{ form_widget(form.status, {'attr': {'class': 'sem-form-input'}}) }}
        {{ form_errors(form.status) }}
        <small class="sem-form-text">Select order status</small>
    </div>

    <div class="sem-form-actions">
        <button type="submit" class="sem-btn sem-btn-primary">
            <span>💾</span> {{ button_label|default('Create Order') }}
        </button>
        <a href="{{ path('app_order_index') }}" class="sem-btn sem-btn-secondary">
            <span>←</span> Back to List
        </a>
    </div>

{{ form_end(form) }}