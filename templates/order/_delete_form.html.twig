<form method="post" action="{{ path('app_order_delete', {'id': order.id}) }}" 
      onsubmit="return confirm('Are you sure you want to delete order #{{ order.id }}? This action cannot be undone.');"
      class="delete-form">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ order.id) }}">
    <button type="submit" class="btn delete-btn" style="background-color: #dc3545; padding: 0.8rem 2rem; border: none; border-radius: 5px; color: white; cursor: pointer; font-weight: 500; transition: all 0.2s ease;">
        Delete Order
    </button>
</form>