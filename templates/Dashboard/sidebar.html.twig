{# dashboard/sidebar.html.twig - PROFESSIONAL DESIGN #}
{% block stylesheets %}
<style>
    /* ==========================================================
       PROFESSIONAL SIDEBAR DESIGN - Orange/Brown Theme
       ========================================================== */
    
    :root {
        --sidebar-bg: #2C1810; /* Deep chocolate brown */
        --sidebar-light: #3D2518; /* Medium brown */
        --accent-primary: #D45B12; /* Warm orange */
        --accent-secondary: #B34A0E; /* Darker orange */
        --accent-hover: #E6691E; /* Brighter orange */
        --text-primary: #F5E6D3; /* Creamy white */
        --text-secondary: #D4B483; /* Light brown text */
        --text-muted: #A68C6D; /* Muted brown */
        --border-color: #5D4C3A; /* Brown border */
        --shadow-color: rgba(0, 0, 0, 0.3);
        --sidebar-width: 280px;
        --transition-speed: 0.25s;
    }

    /* Professional Toggle Button */
    .sidebar-toggle {
        position: fixed;
        top: 25px;
        left: 25px;
        z-index: 1000;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        color: white;
        border: none;
        border-radius: 10px;
        width: 52px;
        height: 52px;
        font-size: 1.4rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 4px 15px rgba(212, 91, 18, 0.3);
        font-family: 'Segoe UI', system-ui, sans-serif;
        padding: 0;
    }

    .sidebar-toggle:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(212, 91, 18, 0.4);
        background: linear-gradient(135deg, var(--accent-hover), var(--accent-primary));
    }

    .sidebar-toggle:active {
        transform: translateY(0);
    }

    /* Professional Sidebar */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        width: var(--sidebar-width);
        height: 100vh;
        background: var(--sidebar-bg);
        background-image: 
            linear-gradient(to bottom, transparent 95%, rgba(255, 255, 255, 0.02) 100%),
            radial-gradient(circle at 20% 80%, rgba(212, 91, 18, 0.08) 0%, transparent 50%);
        transform: translateX(-100%);
        transition: transform var(--transition-speed) cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 999;
        overflow-y: auto;
        overflow-x: hidden;
        display: flex;
        flex-direction: column;
        border-right: 1px solid var(--border-color);
        box-shadow: 4px 0 20px var(--shadow-color);
    }

    .sidebar.open {
        transform: translateX(0);
    }

    /* Elegant Logo Section */
    .sidebar .logo {
        padding: 30px 25px;
        text-align: center;
        border-bottom: 1px solid var(--border-color);
        background: linear-gradient(180deg, var(--sidebar-light), var(--sidebar-bg));
        position: relative;
        overflow: hidden;
    }

    .sidebar .logo::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
    }

    .sidebar .logo-icon {
        font-size: 1.8rem;
        font-weight: 800;
        color: var(--accent-primary);
        margin-bottom: 8px;
        letter-spacing: 1px;
        text-transform: uppercase;
        background: linear-gradient(45deg, var(--accent-primary), #F5A742);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .sidebar .logo-subtitle {
        font-size: 0.85rem;
        color: var(--text-secondary);
        font-weight: 300;
        letter-spacing: 2px;
        text-transform: uppercase;
        opacity: 0.8;
    }

    /* Professional Navigation */
    .sidebar .nav {
        list-style: none;
        padding: 20px 15px;
        margin: 0;
        flex-grow: 1;
    }

    .sidebar .nav li {
        margin-bottom: 8px;
    }

    .sidebar .nav a {
        display: flex;
        align-items: center;
        padding: 14px 18px;
        color: var(--text-primary);
        text-decoration: none;
        border-radius: 10px;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-weight: 500;
        font-size: 0.95rem;
        position: relative;
        overflow: hidden;
        background: transparent;
        border: 1px solid transparent;
    }

    /* Hover Effect with Gradient */
    .sidebar .nav a:hover:not(.active) {
        background: linear-gradient(90deg, rgba(212, 91, 18, 0.1), rgba(212, 91, 18, 0.05));
        border-color: rgba(212, 91, 18, 0.2);
        transform: translateX(5px);
        color: white;
    }

    /* Active State with Elegant Design */
    .sidebar .nav a.active {
        background: linear-gradient(90deg, rgba(212, 91, 18, 0.2), rgba(212, 91, 18, 0.15));
        border-left: 4px solid var(--accent-primary);
        color: white;
        font-weight: 600;
        box-shadow: inset 3px 0 10px rgba(212, 91, 18, 0.2);
    }

    .sidebar .nav a.active::before {
        content: '';
        position: absolute;
        right: 10px;
        width: 8px;
        height: 8px;
        background: var(--accent-primary);
        border-radius: 50%;
        animation: pulse 2s infinite;
    }

    @keyframes pulse {
        0%, 100% { opacity: 0.7; }
        50% { opacity: 1; }
    }

    /* Navigation Icons */
    .sidebar .nav-icon {
        margin-right: 15px;
        font-size: 1.2rem;
        width: 24px;
        text-align: center;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .sidebar .nav a:hover .nav-icon {
        transform: scale(1.1);
    }

    .sidebar .nav a.active .nav-icon {
        color: var(--accent-primary);
    }

    /* Status Badge */
    .sidebar .status-badge {
        margin-left: auto;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        color: white;
        font-size: 0.75rem;
        padding: 4px 10px;
        border-radius: 12px;
        font-weight: 600;
        min-width: 24px;
        text-align: center;
        box-shadow: 0 2px 8px rgba(212, 91, 18, 0.3);
    }

    /* Professional User Profile Section */
    .sidebar .sidebar-footer {
        padding: 20px;
        border-top: 1px solid var(--border-color);
        background: var(--sidebar-light);
        margin-top: auto;
        position: relative;
    }

    .sidebar .sidebar-footer::before {
        content: '';
        position: absolute;
        top: 0;
        left: 20%;
        right: 20%;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--accent-primary), transparent);
    }

    .sidebar .user-profile {
        display: flex;
        align-items: center;
        gap: 15px;
        margin-bottom: 20px;
    }

    .sidebar .user-avatar {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--accent-primary), var(--accent-secondary));
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        font-size: 1.3rem;
        box-shadow: 0 4px 12px rgba(212, 91, 18, 0.3);
        transition: all 0.3s ease;
        border: 2px solid rgba(255, 255, 255, 0.1);
    }

    .sidebar .user-profile:hover .user-avatar {
        transform: rotate(5deg);
        box-shadow: 0 6px 16px rgba(212, 91, 18, 0.4);
    }

    .sidebar .user-info {
        flex: 1;
        min-width: 0;
    }

    .sidebar .user-info h4 {
        font-size: 1rem;
        font-weight: 600;
        margin-bottom: 4px;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sidebar .user-info p {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin-bottom: 8px;
        font-weight: 400;
    }

    /* Professional Role Badge */
    .sidebar .user-role-badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 15px;
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        background: rgba(212, 91, 18, 0.15);
        border: 1px solid rgba(212, 91, 18, 0.3);
        color: var(--accent-primary);
    }

    .sidebar .user-role-badge.admin {
        background: rgba(212, 91, 18, 0.25);
        border-color: var(--accent-primary);
        color: #FFB347;
    }

    .sidebar .user-role-badge.staff {
        background: rgba(180, 74, 14, 0.15);
        color: #E6A157;
    }

    /* Professional Logout Button */
    .sidebar .logout-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        width: 100%;
        padding: 12px;
        background: linear-gradient(135deg, rgba(179, 74, 14, 0.15), rgba(212, 91, 18, 0.1));
        color: var(--text-secondary);
        border: 1px solid rgba(212, 91, 18, 0.2);
        border-radius: 10px;
        cursor: pointer;
        font-weight: 600;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        text-decoration: none;
        position: relative;
        overflow: hidden;
    }

    .sidebar .logout-btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent);
        transition: left 0.5s ease;
    }

    .sidebar .logout-btn:hover {
        background: linear-gradient(135deg, rgba(212, 91, 18, 0.2), rgba(179, 74, 14, 0.15));
        border-color: rgba(212, 91, 18, 0.3);
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(212, 91, 18, 0.2);
    }

    .sidebar .logout-btn:hover::before {
        left: 100%;
    }

    .sidebar .logout-btn span {
        position: relative;
        z-index: 1;
    }

    /* Mobile Overlay */
    .mobile-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(2px);
        z-index: 998;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .mobile-overlay.show {
        display: block;
        opacity: 1;
    }

    /* Desktop View */
    @media (min-width: 1200px) {
        .sidebar-toggle {
            display: none;
        }
        
        .sidebar {
            transform: translateX(0) !important;
        }
        
        .mobile-overlay {
            display: none !important;
        }
    }

    /* Custom Scrollbar */
    .sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar::-webkit-scrollbar-track {
        background: var(--sidebar-light);
        border-radius: 3px;
    }

    .sidebar::-webkit-scrollbar-thumb {
        background: linear-gradient(var(--accent-primary), var(--accent-secondary));
        border-radius: 3px;
    }

    .sidebar::-webkit-scrollbar-thumb:hover {
        background: linear-gradient(var(--accent-hover), var(--accent-primary));
    }

    /* Responsive Design */
    @media (max-width: 1199px) {
        .sidebar-toggle {
            display: flex;
        }
    }

    @media (max-width: 768px) {
        .sidebar {
            width: 85%;
            max-width: 300px;
        }
        
        .sidebar .logo {
            padding: 25px 20px;
        }
        
        .sidebar .nav a {
            padding: 16px 20px;
        }
    }

    /* Touch Device Optimizations */
    @media (hover: none) and (pointer: coarse) {
        .sidebar .nav a {
            padding: 18px 20px;
            min-height: 60px;
        }
        
        .sidebar-toggle {
            min-height: 60px;
            min-width: 60px;
        }
    }

    /* Dark Mode Support */
    @media (prefers-color-scheme: dark) {
        .sidebar {
            --sidebar-bg: #24150E;
            --sidebar-light: #2C1810;
        }
    }
</style>
{% endblock %}

{% block body %}
<!-- Professional Sidebar -->
<div class="sidebar-container">
    <!-- Toggle Button -->
    <button class="sidebar-toggle" id="sidebarToggle" aria-label="Toggle sidebar" title="Toggle navigation">
        <span>☰</span>
    </button>

    <!-- Sidebar -->
    <aside class="sidebar" id="sidebarMenu">
        <!-- Logo Section -->
        <div class="logo">
            <div class="logo-icon">
                {% if app.user %}
                    {% if is_granted('ROLE_ADMIN') %}
                        ADMIN PANEL
                    {% elseif is_granted('ROLE_staff') %}
                        STAFF PANEL
                    {% else %}
                        PET STORE
                    {% endif %}
                {% else %}
                    PET STORE
                {% endif %}
            </div>
            <div class="logo-subtitle">Management System</div>
        </div>
        
        <!-- Navigation -->
        <ul class="nav">
            <!-- Dashboard - Only for Staff and Admin -->
            {% if is_granted('ROLE_staff') or is_granted('ROLE_ADMIN') %}
            <li>
                <a href="{{ path('app_dashboard') }}"
                   class="{% if app.request.attributes.get('_route') == 'app_dashboard' %}active{% endif %}">
                    <span class="nav-icon">📊</span>
                    <span>Dashboard</span>
                </a>
            </li>
            {% endif %}
            
            <!-- My Profile - All logged-in users can see -->
            <li>
                <a href="{{ path('app_user_profile') }}"
                   class="{% if app.request.attributes.get('_route') == 'app_user_profile' %}active{% endif %}">
                    <span class="nav-icon">👤</span>
                    <span>My Profile</span>
                </a>
            </li>
            
            <!-- Products - Only for Staff and Admin -->
            {% if is_granted('ROLE_staff') or is_granted('ROLE_ADMIN') %}
            <li>
                <a href="{{ path('app_petproducts_index') }}"
                   class="{% if app.request.attributes.get('_route') starts with 'app_petproducts' %}active{% endif %}">
                    <span class="nav-icon">📦</span>
                    <span>Products</span>
                    {% if totalProducts is defined %}
                    <span class="status-badge">{{ totalProducts }}</span>
                    {% endif %}
                </a>
            </li>
            {% endif %}
            
            <!-- Users Management - ONLY FOR ADMIN -->
            {% if is_granted('ROLE_ADMIN') %}
            <li>
                <a href="{{ path('app_user_index') }}"
                   class="{% if app.request.attributes.get('_route') starts with 'app_user' and app.request.attributes.get('_route') != 'app_user_profile' %}active{% endif %}">
                    <span class="nav-icon">👥</span>
                    <span>Users</span>
                </a>
            </li>
            {% endif %}
            
            <!-- Activity Log - ONLY FOR ADMIN -->
            {% if is_granted('ROLE_ADMIN') %}
            <li>
                <a href="{{ path('app_activity_log') }}"
                   class="{% if app.request.attributes.get('_route') starts with 'app_activity_log' %}active{% endif %}">
                    <span class="nav-icon">📜</span>
                    <span>Activity Log</span>
                </a>
            </li>
            {% endif %}
        </ul>
        
        <!-- User Profile Footer -->
        <div class="sidebar-footer">
            <div class="user-profile">
                <div class="user-avatar">
                    {% if app.user %}
                        {{ app.user.username|first|upper }}
                    {% else %}
                        G
                    {% endif %}
                </div>
                <div class="user-info">
                    <h4>
                        {% if app.user %}
                            {{ app.user.username }}
                        {% else %}
                            Guest User
                        {% endif %}
                    </h4>
                    <p>
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                System Administrator
                            {% elseif is_granted('ROLE_staff') %}
                                Staff Member
                            {% else %}
                                Regular User
                            {% endif %}
                        {% else %}
                            Guest Account
                        {% endif %}
                    </p>
                    <span class="user-role-badge 
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}admin
                            {% elseif is_granted('ROLE_staff') %}staff
                            {% else %}user{% endif %}
                        {% else %}
                            user
                        {% endif %}">
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                Administrator
                            {% elseif is_granted('ROLE_staff') %}
                                Staff
                            {% else %}
                                User
                            {% endif %}
                        {% else %}
                            Guest
                        {% endif %}
                    </span>
                </div>
            </div>
            
            <a href="{{ path('app_logout') }}" class="logout-btn">
                <span class="nav-icon">🚪</span>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- Mobile Overlay -->
    <div class="mobile-overlay" id="mobileOverlay"></div>
</div>

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        'use strict';
        
        // Cache DOM elements
        const toggleBtn = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebarMenu');
        const mobileOverlay = document.getElementById('mobileOverlay');
        
        // Initialize sidebar state
        function initSidebar() {
            const isDesktop = window.innerWidth >= 1200;
            if (isDesktop) {
                sidebar.classList.add('open');
                mobileOverlay.classList.remove('show');
            }
        }
        
        // Toggle sidebar with smooth animation
        function toggleSidebar() {
            const isOpen = sidebar.classList.contains('open');
            
            if (isOpen) {
                sidebar.classList.remove('open');
                mobileOverlay.classList.remove('show');
            } else {
                sidebar.classList.add('open');
                if (window.innerWidth < 1200) {
                    mobileOverlay.classList.add('show');
                }
            }
        }
        
        // Close sidebar
        function closeSidebar() {
            if (window.innerWidth < 1200) {
                sidebar.classList.remove('open');
                mobileOverlay.classList.remove('show');
            }
        }
        
        // Add event listeners
        if (toggleBtn) {
            toggleBtn.addEventListener('click', toggleSidebar);
        }
        
        if (mobileOverlay) {
            mobileOverlay.addEventListener('click', closeSidebar);
        }
        
        // Close on escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeSidebar();
            }
        });
        
        // Handle window resize with debouncing
        let resizeTimer;
        window.addEventListener('resize', function() {
            clearTimeout(resizeTimer);
            resizeTimer = setTimeout(function() {
                initSidebar();
            }, 100);
        });
        
        // Initialize sidebar
        initSidebar();
        
        // Add subtle animation to nav items on load
        setTimeout(() => {
            const navItems = document.querySelectorAll('.sidebar .nav li');
            navItems.forEach((item, index) => {
                item.style.opacity = '0';
                item.style.transform = 'translateX(-10px)';
                item.style.transition = `opacity 0.3s ease ${index * 0.05}s, transform 0.3s ease ${index * 0.05}s`;
                
                setTimeout(() => {
                    item.style.opacity = '1';
                    item.style.transform = 'translateX(0)';
                }, 50);
            });
        }, 300);
    });
</script>
{% endblock %}
{% endblock %}