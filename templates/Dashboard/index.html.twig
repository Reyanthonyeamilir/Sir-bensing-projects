{# templates/Dashboard/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Pet Products Dashboard{% endblock %}

{% block body %}

{# Include Sidebar #}
{% include 'Dashboard/sidebar.html.twig' %}

<style>
/* === FIXED LAYOUT: MAIN CONTENT ADJUSTS TO SIDEBAR === */
.main-content {
    margin-left: 280px;                   /* Always sits beside sidebar */
    padding: 30px;
    width: calc(100% - 280px);            /* Use remaining space */
    min-height: 100vh;
    background: #f9f5f0;
    transition: margin-left 0.3s ease, width 0.3s ease;
}

/* If your sidebar collapses, use this class */
body.sidebar-collapsed .main-content {
    margin-left: 0 !important;
    width: 100% !important;
}

/* MOBILE FIX */
@media (max-width: 768px) {
    .main-content {
        margin-left: 0 !important;
        width: 100% !important;
        padding: 20px;
    }
}

/* ========================= */
/* Your existing dashboard styles */
/* ========================= */

.dashboard-header {
    margin-bottom: 40px;
    text-align: center;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
}

.dashboard-title {
    color: #3a2610;
    font-size: 2.8rem;
    margin-bottom: 15px;
    font-weight: 700;
    line-height: 1.3;
    font-family: 'Chewy', cursive;
}

.dashboard-subtitle {
    color: #6b4f35;
    font-size: 1.2rem;
    font-family: 'Poppins', sans-serif;
    max-width: 800px;
    margin: 0 auto;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
}

.stat-card {
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(46, 21, 4, 0.1);
    border-left: 6px solid #ff7b35;
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(46, 21, 4, 0.15);
}

.stat-title {
    color: #6b4f35;
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 15px;
    font-family: 'Poppins', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat-value {
    color: #3a2610;
    font-size: 2.8rem;
    font-weight: 700;
    font-family: 'Chewy', cursive;
    line-height: 1;
}

.stat-subvalue {
    color: #ff7b35;
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 10px;
    font-family: 'Poppins', sans-serif;
}

.content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
}

.content-card {
    background: white;
    border-radius: 16px;
    padding: 35px;
    box-shadow: 0 8px 25px rgba(46, 21, 4, 0.1);
    transition: transform 0.3s ease;
}

.content-card:hover {
    transform: translateY(-5px);
}

.card-title {
    color: #3a2610;
    font-size: 1.6rem;
    margin-bottom: 25px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    border-bottom: 2px solid rgba(255, 123, 53, 0.2);
    padding-bottom: 10px;
}

.card-text {
    color: #6b4f35;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 20px;
    font-family: 'Poppins', sans-serif;
}

.card-text ul {
    list-style-type: none;
    padding-left: 0;
}

.card-text li {
    padding: 8px 0;
    padding-left: 25px;
    position: relative;
}

.card-text li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #ff7b35;
    font-weight: bold;
}

/* Quick Links */
.quick-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 15px;
    margin-top: 20px;
}

.quick-link {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: #fff8f0;
    border-radius: 10px;
    text-decoration: none;
    color: #5a3922;
    transition: all 0.3s ease;
    border: 2px solid transparent;
}

.quick-link:hover {
    background: #ff7b35;
    color: white;
    transform: translateY(-3px);
    border-color: #ff7b35;
}

.quick-link-icon {
    font-size: 2rem;
    margin-bottom: 10px;
}

.quick-link-text {
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
}

/* Responsive scaling */
@media (max-width: 1024px) {
    .dashboard-title {
        font-size: 2.2rem;
    }
}

@media (max-width: 768px) {
    .dashboard-title {
        font-size: 1.8rem;
    }
    .stat-value {
        font-size: 2.2rem;
    }
    .quick-links {
        grid-template-columns: repeat(2, 1fr);
    }
}
</style>

<main class="main-content" id="mainContent">
    <div class="dashboard-content center-container">
        <div class="centered-content">
            <div class="dashboard-header">
                <h1 class="dashboard-title">Dashboard Overview</h1>
                <p class="dashboard-subtitle">
                    Welcome back, {{ app.user.username }}!
                    {% if is_granted('ROLE_ADMIN') %}
                        You're logged in as Administrator
                    {% elseif is_granted('ROLE_staff') %}
                        You're logged in as Staff Member
                    {% else %}
                        Welcome to your dashboard
                    {% endif %}
                </p>
            </div>

            <div class="stats-grid">
                {% if totalProducts is defined %}
                <div class="stat-card">
                    <div class="stat-title">Total Products</div>
                    <div class="stat-value">{{ totalProducts }}</div>
                    <div class="stat-subvalue">Active products in store</div>
                </div>
                {% endif %}

                {% if is_granted('ROLE_ADMIN') and totalUsers is defined %}
                <div class="stat-card">
                    <div class="stat-title">Total Users</div>
                    <div class="stat-value">{{ totalUsers }}</div>
                    <div class="stat-subvalue">Registered users</div>
                </div>
                {% endif %}

                {% if totalCategories is defined %}
                <div class="stat-card">
                    <div class="stat-title">Categories</div>
                    <div class="stat-value">{{ totalCategories }}</div>
                    <div class="stat-subvalue">Product categories</div>
                </div>
                {% endif %}

                {% if totalStock is defined %}
                <div class="stat-card">
                    <div class="stat-title">Total Stock</div>
                    <div class="stat-value">{{ totalStock }}</div>
                    <div class="stat-subvalue">Items available</div>
                </div>
                {% endif %}

                {% if totalValue is defined and is_granted('ROLE_ADMIN') %}
                <div class="stat-card">
                    <div class="stat-title">Inventory Value</div>
                    <div class="stat-value">${{ totalValue|number_format(2) }}</div>
                    <div class="stat-subvalue">Total product value</div>
                </div>
                {% endif %}
            </div>

            <div class="content-grid">
                <div class="content-card">
                    <h2 class="card-title">Quick Actions</h2>
                    <div class="card-text">
                        {% if is_granted('ROLE_ADMIN') %}
                        <ul>
                            <li>Manage all users and permissions</li>
                            <li>View system reports and analytics</li>
                            <li>Configure application settings</li>
                            <li>Monitor activity logs</li>
                        </ul>
                        {% elseif is_granted('ROLE_staff') %}
                        <ul>
                            <li>Add new pet products</li>
                            <li>Update product stock and details</li>
                            <li>Manage product categories</li>
                            <li>View product inventory</li>
                        </ul>
                        {% else %}
                        <ul>
                            <li>Browse available products</li>
                            <li>View product details</li>
                            <li>Manage your account</li>
                        </ul>
                        {% endif %}
                    </div>
                    
                    <div class="quick-links">
                        {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_staff') %}
                            <a href="{{ path('app_petproducts_new') }}" class="quick-link">
                                <span class="quick-link-icon">➕</span>
                                <span class="quick-link-text">Add Product</span>
                            </a>
                            
                            <a href="{{ path('app_petproducts_index') }}" class="quick-link">
                                <span class="quick-link-icon">📦</span>
                                <span class="quick-link-text">View Products</span>
                            </a>
                        {% endif %}
                        
                        {% if is_granted('ROLE_ADMIN') %}
                            <a href="{{ path('app_user_index') }}" class="quick-link">
                                <span class="quick-link-icon">👥</span>
                                <span class="quick-link-text">Manage Users</span>
                            </a>
                            
                            <a href="{{ path('app_activity_log') }}" class="quick-link">
                                <span class="quick-link-icon">📜</span>
                                <span class="quick-link-text">Activity Log</span>
                            </a>
                        {% endif %}
                        
                        <a href="{{ path('app_user_profile') }}" class="quick-link">
                            <span class="quick-link-icon">👤</span>
                            <span class="quick-link-text">My Profile</span>
                        </a>
                    </div>
                </div>

                <div class="content-card">
                    <h2 class="card-title">Recent Activities</h2>
                    <div class="card-text">
                        {% if is_granted('ROLE_ADMIN') %}
                        <strong>Administrator Panel:</strong> You have full access to manage the entire system including users, products, and activity logs.
                        {% elseif is_granted('ROLE_staff') %}
                        <strong>Staff Panel:</strong> You can manage products and view inventory. You have limited access compared to administrators.
                        {% else %}
                        <strong>User Panel:</strong> Browse and view products. Contact staff for assistance.
                        {% endif %}
                    </div>
                    
                    <div class="card-text">
                        <strong>System Status:</strong>
                        <ul>
                            <li>Dashboard loaded successfully</li>
                            <li>User session active</li>
                            <li>Database connection established</li>
                            <li>All systems operational</li>
                        </ul>
                    </div>
                    
                    <div class="card-text">
                        <strong>Last updated:</strong> {{ "now"|date("F j, Y g:i A") }}
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
    // Add hover effects to stat cards
    document.querySelectorAll('.stat-card').forEach(card => {
        card.addEventListener('mouseenter', () => card.style.transform = 'translateY(-8px)');
        card.addEventListener('mouseleave', () => card.style.transform = 'translateY(0)');
    });
    
    // Add hover effects to content cards
    document.querySelectorAll('.content-card').forEach(card => {
        card.addEventListener('mouseenter', () => card.style.transform = 'translateY(-5px)');
        card.addEventListener('mouseleave', () => card.style.transform = 'translateY(0)');
    });
    
    // Add click effects to quick links
    document.querySelectorAll('.quick-link').forEach(link => {
        link.addEventListener('click', function(e) {
            this.style.transform = 'scale(0.95)';
            setTimeout(() => {
                this.style.transform = '';
            }, 150);
        });
    });
});
</script>

{% endblock %}