{# templates/Dashboard/index.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}Pet Products{% endblock %}

{% block body %}

{# Include Sidebar #}
{% include 'Dashboard/sidebar.html.twig' %}

<style>
/* === FIXED LAYOUT: MAIN CONTENT ADJUSTS TO SIDEBAR === */
.main-content {
    margin-left: 280px;                   /* Always sits beside sidebar */
    padding: 30px;
    width: calc(100% - 280px);            /* Use remaining space */
    min-height: 100vh;
    background: #f9f5f0;
    transition: margin-left 0.3s ease, width 0.3s ease;
}

/* If your sidebar collapses, use this class */
body.sidebar-collapsed .main-content {
    margin-left: 0 !important;
    width: 100% !important;
}

/* MOBILE FIX */
@media (max-width: 768px) {
    .main-content {
        margin-left: 0 !important;
        width: 100% !important;
        padding: 20px;
    }
}

/* ========================= */
/* Your existing dashboard styles */
/* ========================= */

.dashboard-header {
    margin-bottom: 40px;
    text-align: center;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
}

.dashboard-title {
    color: #3a2610;
    font-size: 2.8rem;
    margin-bottom: 15px;
    font-weight: 700;
    line-height: 1.3;
    font-family: 'Chewy', cursive;
}

.dashboard-subtitle {
    color: #6b4f35;
    font-size: 1.2rem;
    font-family: 'Poppins', sans-serif;
    max-width: 800px;
    margin: 0 auto;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 30px;
    margin-bottom: 50px;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
}

.stat-card {
    background: white;
    padding: 30px;
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(46, 21, 4, 0.1);
    border-left: 6px solid #ff7b35;
    transition: all 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 15px 35px rgba(46, 21, 4, 0.15);
}

.stat-title {
    color: #6b4f35;
    font-size: 1.1rem;
    font-weight: 500;
    margin-bottom: 15px;
    font-family: 'Poppins', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat-value {
    color: #3a2610;
    font-size: 2.8rem;
    font-weight: 700;
    font-family: 'Chewy', cursive;
    line-height: 1;
}

.stat-subvalue {
    color: #ff7b35;
    font-size: 1.1rem;
    font-weight: 600;
    margin-top: 10px;
    font-family: 'Poppins', sans-serif;
}

.content-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 30px;
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
}

.content-card {
    background: white;
    border-radius: 16px;
    padding: 35px;
    box-shadow: 0 8px 25px rgba(46, 21, 4, 0.1);
    transition: transform 0.3s ease;
}

.content-card:hover {
    transform: translateY(-5px);
}

.card-title {
    color: #3a2610;
    font-size: 1.6rem;
    margin-bottom: 25px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    border-bottom: 2px solid rgba(255, 123, 53, 0.2);
    padding-bottom: 10px;
}

.card-text {
    color: #6b4f35;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 20px;
    font-family: 'Poppins', sans-serif;
}

.card-text ul {
    list-style-type: none;
    padding-left: 0;
}

.card-text li {
    padding: 8px 0;
    padding-left: 25px;
    position: relative;
}

.card-text li:before {
    content: "✓";
    position: absolute;
    left: 0;
    color: #ff7b35;
    font-weight: bold;
}

/* Responsive scaling */
@media (max-width: 1024px) {
    .dashboard-title {
        font-size: 2.2rem;
    }
}

@media (max-width: 768px) {
    .dashboard-title {
        font-size: 1.8rem;
    }
    .stat-value {
        font-size: 2.2rem;
    }
}
</style>

<main class="main-content" id="mainContent">
    <div class="dashboard-content center-container">
        <div class="centered-content">
            <div class="dashboard-header">
                <h1 class="dashboard-title">Dashboard Overview</h1>
                <p class="dashboard-subtitle">
                    Welcome back, {{ app.user.username }}!
                    {% if 'ROLE_ADMIN' in app.user.roles %}
                        You're logged in as Administrator
                    {% else %}
                        You're logged in as Staff Member
                    {% endif %}
                </p>
            </div>

            <div class="stats-grid">
                {% if totalProducts is defined %}
                <div class="stat-card">
                    <div class="stat-title">Total Products</div>
                    <div class="stat-value">{{ totalProducts }}</div>
                </div>
                {% endif %}

                {% if 'ROLE_ADMIN' in app.user.roles and totalUsers is defined %}
                <div class="stat-card">
                    <div class="stat-title">Total Users</div>
                    <div class="stat-value">{{ totalUsers }}</div>
                </div>
                {% endif %}

                {% if 'ROLE_ADMIN' in app.user.roles and totalPrice is defined %}
                <div class="stat-card">
                    <div class="stat-title">Total Value</div>
                    <div class="stat-value">${{ totalPrice|number_format(2) }}</div>
                    {% if priceGrowth is defined %}
                    <div class="stat-subvalue">Price Growth: {{ priceGrowth }}%</div>
                    {% endif %}
                </div>
                {% endif %}

                {% if bookingsCount is defined %}
                <div class="stat-card">
                    <div class="stat-title">Bookings</div>
                    <div class="stat-value">{{ bookingsCount }}</div>
                    <div class="stat-subvalue">Today's bookings</div>
                </div>
                {% endif %}
            </div>

            <div class="content-grid">
                <div class="content-card">
                    <h2 class="card-title">Quick Actions</h2>
                    <div class="card-text">
                        {% if 'ROLE_ADMIN' in app.user.roles %}
                        <ul>
                            <li>View user statistics and reports</li>
                            <li>Configure system settings</li>
                            <li>Manage staff accounts</li>
                        </ul>
                        {% elseif 'ROLE_STAFF' in app.user.roles %}
                        <ul>
                            <li>View and manage products</li>
                            <li>Process customer bookings</li>
                            <li>View daily reports</li>
                        </ul>
                        {% else %}
                        Browse products and manage your orders.
                        {% endif %}
                    </div>
                </div>

                <div class="content-card">
                    <h2 class="card-title">Recent Activities</h2>
                    <div class="card-text">
                        {% if 'ROLE_ADMIN' in app.user.roles %}
                        <strong>Admin Activity:</strong> Monitor system performance.
                        {% else %}
                        <strong>User Activity:</strong> View your order and booking history.
                        {% endif %}
                    </div>
                    <div class="card-text">Last updated: {{ "now"|date("Y-m-d H:i:s") }}</div>
                </div>
            </div>
        </div>
    </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.stat-card').forEach(card => {
        card.addEventListener('mouseenter', () => card.style.transform = 'translateY(-8px)');
        card.addEventListener('mouseleave', () => card.style.transform = 'translateY(0)');
    });
});
</script>

{% endblock %}
