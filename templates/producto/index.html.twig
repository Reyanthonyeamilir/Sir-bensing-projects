{% extends 'base.html.twig' %}

{% block title %}Producto index{% endblock %}

{% block body %}
<style>
    body {
        background-color: #cc6600; /* orange-brown background */
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 20px;
        color: #fff; /* white text for contrast */
    }

    h1 {
        text-align: center;
        color: #fff;
        margin-bottom: 20px;
    }

    .table {
        width: 100%;
        border-collapse: collapse;
        background: #fff;
        color: #333;
        border-radius: 8px;
        overflow: hidden;
    }

    .table th {
        background-color: #a64d00; /* darker brown header */
        color: #fff;
        padding: 10px;
        text-align: left;
    }

    .table td {
        padding: 10px;
        border-bottom: 1px solid #ddd;
    }

    .table tr:nth-child(even) {
        background-color: #f9f2ec;
    }

    a {
        color: #cc6600;
        font-weight: bold;
        text-decoration: none;
    }

    a:hover {
        text-decoration: underline;
    }

   .actions {
    display: flex;
    justify-content: flex-end; /* moves button to right */
    margin-bottom: 15px;
}

.btn-create {
    display: inline-block;
    padding: 10px 18px;
    background-color: #ff6600; /* bright orange */
    color: #fff;
    font-weight: bold;
    border-radius: 6px;
    text-decoration: none;
    box-shadow: 0 3px 5px rgba(0,0,0,0.2);
    transition: background 0.3s ease, transform 0.2s ease;
}

.btn-create:hover {
    background-color: #cc5200; /* darker on hover */
    transform: translateY(-2px);
}


</style>
    <h1>Pet Product index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Petname</th>
                <th>Age</th>
                <th>Product_name</th>
                <th>Price</th>
                <th>Quantity</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for producto in productos %}
            <tr>
                <td>{{ producto.id }}</td>
                <td>{{ producto.Petname }}</td>
                <td>{{ producto.Age }}</td>
                <td>{{ producto.ProductName }}</td>
                <td>{{ producto.Price }}</td>
                <td>{{ producto.quantity }}</td>
                <td>
                <a href="{{ path('app_producto_show', {'id': producto.id}) }}" class="btn-create">Show</a>
<a href="{{ path('app_producto_edit', {'id': producto.id}) }}" class="btn-create">Edit</a>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

   <div class="actions">
    <a href="{{ path('app_producto_new') }}" class="btn-create">➕ Create new</a>
</div>
<table class="table">
    ...
</table>
{% endblock %}
