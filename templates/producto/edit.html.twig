{% extends 'base.html.twig' %}

{% block title %}Edit Producto{% endblock %}

{% block body %}
<style>
/* === Global Page Styling === */
body {
    background: linear-gradient(135deg, #cc6600, #b34700); /* orange-brown gradient */
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
    margin: 0;
    font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
}

/* === Container Card === */
.crud-container {
    background: #fff;
    padding: 35px;
    border-radius: 15px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.3);
    width: 95%;
    max-width: 700px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    animation: fadeIn 0.6s ease-in-out;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(20px); }
    to   { opacity: 1; transform: translateY(0); }
}

/* === Title === */
.crud-container h1 {
    text-align: center;
    font-size: 2rem;
    color: #cc6600;
    font-weight: bold;
    border-bottom: 2px solid #cc6600;
    padding-bottom: 10px;
    margin-bottom: 20px;
}

/* === Form Styling === */
form {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

form label {
    font-weight: bold;
    color: #b34700;
}

form input, form select, form textarea {
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 8px;
    outline: none;
    transition: all 0.3s ease;
}

form input:focus, form select:focus, form textarea:focus {
    border-color: #cc6600;
    box-shadow: 0 0 6px rgba(204, 102, 0, 0.4);
}

/* === Buttons === */
.btn {
    display: inline-block;
    padding: 12px 20px;
    background-color: #ff6600;
    color: #fff;
    font-weight: bold;
    border-radius: 8px;
    text-decoration: none;
    text-align: center;
    box-shadow: 0 4px 8px rgba(0,0,0,0.2);
    transition: background 0.3s ease, transform 0.2s ease;
    cursor: pointer;
}

.btn:hover {
    background-color: #cc5200;
    transform: translateY(-2px);
}

.btn-danger {
    background-color: #b34700;
}

.btn-danger:hover {
    background-color: #802b00;
}

/* === Actions Section === */
.actions {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    margin-top: 15px;
}
</style>

<div class="crud-container">
    <h1>Edit Pet Product</h1>

    {{ include('producto/_form.html.twig', {'button_label': 'Update'}) }}

    <div class="actions">
        <a href="{{ path('app_producto_index') }}" class="btn">⬅ Back to list</a>
        {{ include('producto/_delete_form.html.twig', { 'button_label': 'Delete' }) }}
    </div>
</div>
{% endblock %}
