{# Aligned, responsive form UI #}

<style>
  /* Container (optional, remove if you already have a wrapper) */
  .form-wrap {
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 10px 24px rgba(0,0,0,.12);
      padding: 28px;
      max-width: 820px;
      margin: 24px auto;
      font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial;
  }

  /* Title (optional) */
  .form-title {
      margin: 0 0 18px;
      font-size: 22px;
      font-weight: 700;
      color: #222;
  }

  /* Grid that aligns fields */
  .form-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 16px 18px;
  }
  @media (min-width: 720px) {
      .form-grid {
          grid-template-columns: 1fr 1fr; /* two columns on wider screens */
      }
  }

  /* Make a field span full width when needed */
  .col-span-2 {
      grid-column: 1 / -1;
  }

  /* Field group */
  .form-item {
      display: flex;
      flex-direction: column;
      gap: 6px;
  }

  /* Labels */
  .form-item label {
      font-weight: 600;
      font-size: 14px;
      color: #333;
  }

  /* Inputs / selects / textareas */
  .form-control {
      width: 100%;
      padding: 11px 12px;
      border: 1px solid #ddd;
      border-radius: 8px;
      font-size: 15px;
      transition: border-color .2s ease, box-shadow .2s ease;
      background: #fff;
  }
  .form-control:focus {
      outline: none;
      border-color: #ff6600;
      box-shadow: 0 0 0 3px rgba(255,102,0,.15);
  }

  /* Errors */
  .form-error {
      color: #b00020;
      font-size: 13px;
  }

  /* Actions */
  .form-actions {
      display: flex;
      gap: 10px;
      justify-content: flex-end;
      margin-top: 12px;
  }

  .btn {
      appearance: none;
      border: 0;
      border-radius: 10px;
      padding: 12px 18px;
      font-weight: 700;
      font-size: 15px;
      cursor: pointer;
      transition: transform .15s ease, box-shadow .15s ease, background .2s ease;
  }

  .btn-primary {
      background: #ff6600;
      color: #fff;
      box-shadow: 0 6px 14px rgba(255,102,0,.25);
  }
  .btn-primary:hover {
      background: #cc5200;
      transform: translateY(-1px);
  }
</style>

<div class="form-wrap">
  <h2 class="form-title">Create / Edit</h2>

  {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

  <div class="form-grid">
    {# Render each *visible* field aligned in the grid #}
    {% for child in form %}
      {% if 'hidden' not in child.vars.block_prefixes %}
        {# If you want certain fields full-width, add .col-span-2 conditionally by name #}
        <div class="form-item {{ child.vars.name in ['description','notes','details'] ? 'col-span-2' : '' }}">
          {{ form_label(child) }}
          {{ form_widget(child, {'attr': {'class': 'form-control'}}) }}
          {% if form_errors(child) is not empty %}
            <div class="form-error">{{ form_errors(child) }}</div>
          {% endif %}
        </div>
      {% endif %}
    {% endfor %}
  </div>

  {# Render any remaining (hidden) fields like CSRF token #}
  {{ form_rest(form) }}

  <div class="form-actions">
    <button class="btn btn-primary">{{ button_label|default('Save') }}</button>
  </div>

  {{ form_end(form, {'render_rest': false}) }}
</div>
